<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Sem -windows, e de proposito: contratos e politica de divulgacao
         nunca veem COM, WPF, SQLite nem HTTP. O TFM e quem garante. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iris.Assist</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.Model\Iris.Model.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iris.Tests" />
  </ItemGroup>

</Project>
