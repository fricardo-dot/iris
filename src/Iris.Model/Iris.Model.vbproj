<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 SEM -windows de proposito. O interop do Outlook e
         Windows-only; com este TFM a fronteira do ESCOPO.md secao 4 deixa
         de ser convencao e passa a ser impossibilidade de compilacao. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iris.Model</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <!-- A borda que fala com o Outlook e a UNICA que monta MessageSnapshot:
         os campos dele tem de vir de UMA leitura, e essa e a camada que
         sabe disso. Ver o XML doc do tipo, inclusive o que ele NAO prova. -->
    <InternalsVisibleTo Include="Iris.Outlook" />
    <InternalsVisibleTo Include="Iris.Tests" />
  </ItemGroup>

</Project>
