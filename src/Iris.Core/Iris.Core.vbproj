<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Tambem sem -windows: o Core define IOutlookBroker mas nunca ve COM. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iris.Core</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.Model\Iris.Model.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PagingDefects e Friend de proposito: ligar um daqueles defeitos
         perde mensagem em silencio, entao o adaptador COM nao pode nem
         enxergar. O teste precisa, porque controle negativo anotado a
         mao nao e regressao verificavel. -->
    <InternalsVisibleTo Include="Iris.Tests" />
  </ItemGroup>

</Project>
