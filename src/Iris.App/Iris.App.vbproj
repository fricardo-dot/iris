<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Iris.App</RootNamespace>
    <AssemblyName>Iris</AssemblyName>
    <UseWPF>true</UseWPF>
    <StartupObject>Iris.App.Application</StartupObject>

    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>

    <!-- O ícone gravado no cabeçalho do EXE. É este que a barra de tarefas e
         o Explorer usam.

         O arquivo é GERADO por tools/gerar-icone.py, com as cores do
         Themes/Tokens.xaml. Binário versionado que ninguém sabe reproduzir
         vira intocável no dia em que a paleta mudar. -->
    <ApplicationIcon>iris.ico</ApplicationIcon>

    <!-- E só isto. A janela NÃO declara Icon=, e não é esquecimento:

         1. Ela tem chrome próprio: barra de título desenhada à mão, com os
            botões de minimizar e fechar. Não há barra padrão onde um ícone
            de janela apareceria.
         2. A barra de tarefas usa o ícone do EXE, que é este aqui.

         A primeira tentativa pôs Icon="iris.ico" no MainWindow, e o app
         passou a MORRER no arranque: XamlParseException, "Cannot locate
         resource". Acrescentar Resource Include="iris.ico" não resolveu.
         Perseguir aquilo seria consertar um recurso para alimentar um
         atributo que não pinta nada nesta janela. -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.Model\Iris.Model.vbproj" />
    <ProjectReference Include="..\Iris.Core\Iris.Core.vbproj" />

    <!-- Iris.Outlook é referenciado APENAS para o composition root do
         startup montar a implementação concreta. Nenhum ViewModel ou View
         pode tocar neste assembly, e o teste arquitetural
         ViewModels_NaoReferenciam_Outlook falha se alguém tentar. -->
    <ProjectReference Include="..\Iris.Outlook\Iris.Outlook.vbproj" />
    <ProjectReference Include="..\Iris.Cache\Iris.Cache.vbproj" />
    <ProjectReference Include="..\Iris.Integration\Iris.Integration.vbproj" />
    <!-- A varredura: e onde o Outlook vira acervo. -->
    <ProjectReference Include="..\Iris.Integration.Outlook\Iris.Integration.Outlook.vbproj" />
    <ProjectReference Include="..\Iris.Assist\Iris.Assist.vbproj" />
    <!-- O UNICO assembly com HTTP, e o Iris.App e o UNICO que pode
         referencia-lo: aqui e o composition root, o lugar onde a escolha de
         provedor e feita. Qualquer outra referencia a este projeto seria
         egress de segunda mao, e o EgressArquiteturaTests acusa. -->
    <ProjectReference Include="..\Iris.Integration.Assist.Http\Iris.Integration.Assist.Http.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>


  <ItemGroup>
    <!-- ContextoDoOutlook e Friend: ele e a borda que liga a tela ao COM, e
         nao ha razao para o resto do mundo montar um. Os testes precisam
         monta-lo para provar o caminho de PRODUCAO — sem isto, a prova seria
         feita sobre a imitacao, que e exatamente o defeito que a segunda
         passada do Codex apontou. -->
    <InternalsVisibleTo Include="Iris.Tests" />
  </ItemGroup>

</Project>
