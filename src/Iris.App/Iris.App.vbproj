<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Iris.App</RootNamespace>
    <AssemblyName>Iris</AssemblyName>
    <UseWPF>true</UseWPF>
    <StartupObject>Iris.App.Application</StartupObject>

    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>

    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.Model\Iris.Model.vbproj" />
    <ProjectReference Include="..\Iris.Core\Iris.Core.vbproj" />

    <!-- Iris.Outlook é referenciado APENAS para o composition root do
         startup montar a implementação concreta. Nenhum ViewModel ou View
         pode tocar neste assembly, e o teste arquitetural
         ViewModels_NaoReferenciam_Outlook falha se alguém tentar. -->
    <ProjectReference Include="..\Iris.Outlook\Iris.Outlook.vbproj" />
    <ProjectReference Include="..\Iris.Cache\Iris.Cache.vbproj" />
    <ProjectReference Include="..\Iris.Integration\Iris.Integration.vbproj" />
    <ProjectReference Include="..\Iris.Assist\Iris.Assist.vbproj" />
    <!-- O UNICO assembly com HTTP, e o Iris.App e o UNICO que pode
         referencia-lo: aqui e o composition root, o lugar onde a escolha de
         provedor e feita. Qualquer outra referencia a este projeto seria
         egress de segunda mao, e o EgressArquiteturaTests acusa. -->
    <ProjectReference Include="..\Iris.Integration.Assist.Http\Iris.Integration.Assist.Http.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>


  <ItemGroup>
    <!-- ContextoDoOutlook e Friend: ele e a borda que liga a tela ao COM, e
         nao ha razao para o resto do mundo montar um. Os testes precisam
         monta-lo para provar o caminho de PRODUCAO — sem isto, a prova seria
         feita sobre a imitacao, que e exatamente o defeito que a segunda
         passada do Codex apontou. -->
    <InternalsVisibleTo Include="Iris.Tests" />
  </ItemGroup>

</Project>
