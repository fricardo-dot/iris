<UserControl x:Class="Views.FaixaDaIa"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="clr-namespace:Iris.App">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:FracaoDaAltura x:Key="Fracao" />
    </UserControl.Resources>

    <!-- TUDO AQUI E DynamicResource, E ISSO NAO E ESTILO.

         Os testes de renderizacao instanciam esta faixa DIRETAMENTE, com
         `New FaixaDaIa()`, e no processo de teste nao existe Application -
         logo nao existe Application.Current.Resources. StaticResource
         resolve na hora do parse e LANCA quando nao acha: a faixa deixaria
         de carregar no teste inteiro, e o unico jeito de "consertar" seria
         parar de testar a faixa de verdade.

         DynamicResource resolve depois, e a ausencia vira valor padrao em
         vez de excecao. Em producao acha tudo; no teste, o Montar mescla o
         Tema.xaml e a resolucao acontece na sequencia.

         E vale a regra dos Tokens: nada de cor bruta. Foi a falta disso que
         deixou esta faixa herdando preto sobre fundo escuro - o primeiro
         resumo de verdade chegou certo e ilegivel. -->

    <!-- QUATRO LINHAS, E NAO UMA.

         Os botoes moravam dentro da borda de aviso, cuja visibilidade e
         TemAlgoADizer. Com a IA funcionando - sem aviso e sem ambiguidades -
         essa borda colapsa E LEVA OS BOTOES JUNTO: eles sumiam exatamente
         quando estavam habilitados.

         A ordem tambem e decidida: o aviso da cerimonia e o RODAPE, embaixo
         de tudo, porque ele nao fala de um pedido - fala do estado em que a
         IA foi ligada, e isso vale enquanto o programa estiver aberto. No
         meio da pilha ele era empurrado pela resposta e virava uma linha
         perdida entre duas coisas que mudam a cada clique. -->
    <Border Background="{DynamicResource Brush.Surface.1}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="0,1,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- O PAINEL: titulo, acoes e o andamento.

                 Titulo e botoes na MESMA linha da grade, dentro de um
                 StackPanel: as linhas da grade sao contadas por um teste que
                 cobra que aviso e resultado nao se cubram, e o titulo nao e
                 uma faixa - e o cabecalho desta.

                 OS BOTOES SAO VISIVEIS SEMPRE, habilitados so quando da. Um
                 botao que some quando a IA esta desligada esconderia a
                 funcionalidade E o motivo dela estar desligada - e o motivo e
                 exatamente o que o usuario precisa ler, no lugar onde ele
                 procuraria a acao. -->
            <Border Grid.Row="0" Padding="16,10,16,10">
                <StackPanel>
                    <TextBlock Text="PAINEL DA IA"
                               Style="{DynamicResource Text.Muted}"
                               Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Resumir"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding ResumirCommand}"
                                AutomationProperties.Name="Resumir com IA" />
                        <!-- O TOOLTIP DIZ POR QUE ELE ESTA APAGADO.

                             Botao cinza sem explicacao e pior que botao
                             ausente: promete e nao diz o que falta. O motivo
                             mais comum aqui e o mais facil de resolver, e o
                             usuario nao tem como adivinhar: "Redigir" escreve
                             DENTRO de um rascunho, entao precisa de um aberto. -->
                        <Button Content="Redigir resposta"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding RedigirCommand}"
                                ToolTip="{Binding PorQueNaoRedige}"
                                ToolTipService.ShowOnDisabled="True"
                                AutomationProperties.Name="Redigir resposta com IA" />

                        <Border Width="1" Margin="8,6" VerticalAlignment="Stretch"
                                Background="{DynamicResource Brush.Border.Subtle}" />

                        <!-- Copiar exige so TER o que copiar. O texto ja esta na
                             tela e ja foi pago; amarrar a copia a autorizacao
                             faria a IA vencer entre o resumo aparecer e o
                             usuario conseguir leva-lo embora. -->
                        <Button Content="Copiar resumo"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding CopiarCommand}"
                                ToolTip="Copiar a resposta da IA"
                                AutomationProperties.Name="Copiar a resposta da IA" />
                        <Button Content="Desfazer"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding DesfazerCommand}"
                                AutomationProperties.Name="Desfazer a redacao da IA" />
                        <Button Content="Cancelar"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding CancelarCommand}"
                                AutomationProperties.Name="Cancelar o pedido a IA" />

                        <!-- O ANDAMENTO.

                             Uma chamada a modelo demora segundos, e sem nada
                             na tela "esta pensando" e "travou" sao a mesma
                             coisa para quem olha. A barra diz que ha algo
                             acontecendo; o numero diz ha quanto tempo - e o
                             Cancelar ao lado so e uma escolha de verdade para
                             quem sabe quanto ja esperou. -->
                        <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Ocupado,
                                                 Converter={StaticResource BoolToVis},
                                                 FallbackValue=Collapsed}">
                            <ProgressBar IsIndeterminate="True"
                                         Width="90" Height="3"
                                         BorderThickness="0"
                                         Background="{DynamicResource Brush.Surface.3}"
                                         Foreground="{DynamicResource Brush.Accent}"
                                         VerticalAlignment="Center"
                                         AutomationProperties.Name="Consultando a IA" />
                            <TextBlock Text="{Binding Decorrido}"
                                       Style="{DynamicResource Text.Muted}"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       AutomationProperties.Name="Tempo decorrido" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- UMA ROLAGEM SO, E ELA E DAQUI.

                 A faixa e linha Auto do MainWindow: ela cresce e a LISTA DE
                 E-MAILS encolhe na mesma medida. Com resumo e resposta na
                 tela ao mesmo tempo, sobrava uma tira de lista.

                 Antes cada texto tinha o seu ScrollViewer de 240. Tres
                 rolagens aninhadas nao resolvem o problema: cada uma segura
                 o seu texto e a SOMA continua empurrando a lista. Agora e
                 uma so, aqui, com teto - os textos la dentro correm livres.

                 O TETO E FRACAO DA JANELA, e nao pixel fixo: 0,42 da altura
                 aqui, mais cabecalho e rodape que ficam de fora, da perto de
                 metade da tela. Pixel fixo estaria certo na minha janela e
                 errado em todas as outras. FallbackValue=300 porque os testes
                 de renderizacao instanciam a faixa SEM Window em volta, e ali
                 o RelativeSource nao acha ninguem.

                 O cabecalho fica FORA dela, na linha 0: os botoes precisam
                 estar no lugar depois de ler o resumo, e nao rolados para
                 fora da vista. O rodape da cerimonia tambem, na linha 2,
                 pelo motivo de sempre - ele fala do estado, nao do pedido. -->
            <ScrollViewer Grid.Row="1"
                          MaxHeight="{Binding ActualHeight,
                                              RelativeSource={RelativeSource AncestorType=Window},
                                              Converter={StaticResource Fracao},
                                              ConverterParameter=0.42,
                                              FallbackValue=300}"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- O AVISO: o motivo de a IA estar desligada, e o que ficou sem
                         desfecho conhecido numa execucao anterior. -->
                    <!-- TemAvisoDeOperacao, e NAO TemAlgoADizer.

                         TemAlgoADizer conta tambem o aviso da cerimonia, que agora tem
                         linha propria no rodape - entao esta borda ficava VISIVEL com
                         os dois TextBlock dela vazios, ocupando altura. O sintoma era
                         um vao entre os botoes e a resposta que nao dava para explicar
                         olhando o XAML: o espaco era de um elemento presente, e nao de
                         margem.

                         E cada TextBlock some sozinho quando nao tem texto: com um so
                         dos dois preenchido, o outro deixava uma linha em branco. -->
                    <Border Grid.Row="0"
                            Visibility="{Binding TemAvisoDeOperacao, Converter={StaticResource BoolToVis},
                                                 FallbackValue=Collapsed}"
                            Padding="16,0,16,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Aviso}"
                                       Style="{DynamicResource Text.Secondary}"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding TemAviso, Converter={StaticResource BoolToVis},
                                                            FallbackValue=Collapsed}"
                                       AutomationProperties.Name="Situacao da IA" />
                            <!-- O AVISO INTEIRO, e o botao que o encolhe.

                                 Ele dizia "este aviso nao desaparece sozinho", e era
                                 verdade: nao havia como dizer que se viu. Um paragrafo
                                 permanente e um paragrafo que se aprende a nao ler.

                                 Reconhecer NAO desfaz a ambiguidade nem a esconde: ela
                                 vira a marca curta logo abaixo. E envio ambiguo NOVO
                                 faz o paragrafo voltar inteiro, porque o que se guarda
                                 e o NUMERO reconhecido, e nao um "ja vi". -->
                            <StackPanel Margin="0,4,0,0"
                                        Visibility="{Binding TemAvisoDaReconciliacao,
                                                             Converter={StaticResource BoolToVis},
                                                             FallbackValue=Collapsed}">
                                <TextBlock Text="{Binding Reconciliacao.Aviso}"
                                           Style="{DynamicResource Text.Secondary}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Envios sem desfecho conhecido" />
                                <Button Content="Eu vi este aviso"
                                        Style="{DynamicResource Toolbar.Button}"
                                        Command="{Binding ReconhecerAmbiguasCommand}"
                                        HorizontalAlignment="Left" Margin="0,4,0,0"
                                        ToolTip="Encolhe o aviso. A ambiguidade continua registrada, e um envio novo traz o texto de volta."
                                        AutomationProperties.Name="Reconhecer os envios sem desfecho" />
                            </StackPanel>

                            <!-- A MARCA CURTA, depois de reconhecido. Ela nao some: a
                                 ambiguidade continua sendo verdade, e o que mudou foi
                                 so o tamanho com que ela e dita. -->
                            <TextBlock Text="{Binding Reconciliacao.Marca}"
                                       Style="{DynamicResource Text.Muted}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding TemMarcaDaReconciliacao,
                                                            Converter={StaticResource BoolToVis},
                                                            FallbackValue=Collapsed}"
                                       AutomationProperties.Name="Envios sem desfecho conhecido, ja reconhecidos" />
                        </StackPanel>
                    </Border>

                    <!-- O RESULTADO. TextBlock e nao qualquer coisa que interprete: a
                         resposta veio de um lugar que leu o e-mail, que por sua vez veio
                         de fora. Texto passivo e a barreira, e ela e estrutural.

                         O rotulo em cima nao e enfeite: separa o que o MODELO escreveu
                         do que o IRIS escreve. Sem ele, resposta de modelo e frase do
                         programa dividem a mesma tipografia no mesmo rodape, e o
                         usuario nao tem como saber de quem e cada uma - o que e
                         exatamente o que um e-mail mal-intencionado gostaria.

                         E rola: um resumo comprido corria para fora da janela, porque
                         a faixa e a ultima linha Auto do MainWindow e nada a segurava.
                         O fim do texto simplesmente nao existia na tela. -->
                    <Border Grid.Row="1"
                            Visibility="{Binding TemResultado, Converter={StaticResource BoolToVis},
                                                 FallbackValue=Collapsed}"
                            Padding="16,0,16,10">
                        <Border Background="{DynamicResource Brush.Surface.2}"
                                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="RESUMO DA IA"
                                               Style="{DynamicResource Text.Muted}" />
                                    <!-- A FICHA: quem atendeu, quanto custou, quanto
                                         demorou. Agente e modelo vem da ATIVACAO, e nao
                                         do corpo da resposta: aquilo e texto escolhido
                                         pelo outro lado. Da resposta entram so os
                                         numeros. -->
                                    <TextBlock Grid.Column="1" Text="{Binding Ficha}"
                                               Style="{DynamicResource Text.Muted}"
                                               HorizontalAlignment="Right"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Ficha}"
                                               AutomationProperties.Name="Agente, modelo, custo e tempo" />
                                </Grid>
                                <TextBlock Text="{Binding Resultado}"
                                           Style="{DynamicResource Text.Body}"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Resposta da IA" />

                                <!-- O QUE NAO FOI LIDO PARA PRODUZIR ISTO.

                                     Imagem embutida deixou de bloquear o resumo em
                                     30/08 — ela bloqueava 13 de 13 mensagens de uma
                                     pasta real, por causa de logo de assinatura. Mas
                                     uma captura de tela colada no corpo e embutida do
                                     mesmo jeito, e pode carregar a mensagem inteira.

                                     Uma linha, um numero, sem adjetivo: numa caixa
                                     corporativa ela aparece quase sempre, e ressalva
                                     longa que aparece sempre vira ruido. -->
                                <!-- E VISIVEL, para quem nao passa o mouse no botao. -->
                            <TextBlock Text="{Binding PorQueNaoRedige}"
                                       Style="{DynamicResource Text.Muted}"
                                       TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding TemMotivoParaNaoRedigir,
                                                            Converter={StaticResource BoolToVis},
                                                            FallbackValue=Collapsed}"
                                       AutomationProperties.Name="Por que nao da para redigir" />

                            <TextBlock Text="{Binding RessalvaDoConteudo}"
                                           Style="{DynamicResource Text.Muted}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding TemRessalvaDoConteudo,
                                                                Converter={StaticResource BoolToVis},
                                                                FallbackValue=Collapsed}"
                                           AutomationProperties.Name="O que nao foi lido para este resultado" />

                                <!-- ============ A RESPOSTA REDIGIDA ============

                                     Quadro PROPRIO, e nao o mesmo do resumo. Antes,
                                     redigir escrevia por cima do resultado: o resumo
                                     que o usuario acabou de pagar sumia da tela.

                                     E o botao daqui e "Enviar para rascunho", nao
                                     "Copiar". Redigir MOSTRA; aplicar e outro ato. O
                                     botao antigo dizia "redigir" e tambem aplicava, e
                                     ninguem tinha pedido a segunda coisa. 
                                       CornerRadius literal, e nao {StaticResource Radius.Card}:
                                       este UserControl nao tem o dicionario de tokens no escopo,
                                       e recurso ausente vira XamlParseException NO ARRANQUE da
                                       faixa. O quadro de cima ja usava 6 pelo mesmo motivo, e eu
                                       nao olhei. Onze testes de renderizacao pegaram. -->
                                <Border Margin="0,10,0,0" Padding="12,10"
                                        Background="{DynamicResource Brush.Surface.2}"
                                        BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="{Binding TemResposta,
                                                             Converter={StaticResource BoolToVis},
                                                             FallbackValue=Collapsed}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="RESPOSTA REDIGIDA"
                                                       Style="{DynamicResource Text.Muted}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="Enviar para rascunho"
                                                    Style="{DynamicResource Toolbar.Button}"
                                                    Command="{Binding EnviarParaRascunhoCommand}"
                                                    Margin="12,0,0,0"
                                                    ToolTip="{Binding PorQueNaoEnvia}"
                                                    ToolTipService.ShowOnDisabled="True"
                                                    AutomationProperties.Name="Enviar a resposta para o rascunho" />
                                            <Button Content="Copiar resposta"
                                                    Style="{DynamicResource Toolbar.Button}"
                                                    Command="{Binding CopiarRespostaCommand}"
                                                    Margin="6,0,0,0"
                                                    AutomationProperties.Name="Copiar a resposta redigida" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding Resposta}"
                                                   Style="{DynamicResource Text.Body}"
                                                   TextWrapping="Wrap"
                                                   AutomationProperties.Name="Resposta redigida pela IA" />

                                        <!-- Por que o envio ao rascunho esta apagado.
                                             Botao cinza sem explicacao promete e nao
                                             diz o que falta. -->
                                        <TextBlock Text="{Binding PorQueNaoEnvia}"
                                                   Style="{DynamicResource Text.Muted}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Visibility="{Binding TemMotivoParaNaoEnviar,
                                                                        Converter={StaticResource BoolToVis},
                                                                        FallbackValue=Collapsed}"
                                                   AutomationProperties.Name="Por que nao da para enviar ao rascunho" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </ScrollViewer>

            <!-- O RODAPE DA CERIMONIA: por ultimo, e SEMPRE visivel quando tem
                 o que dizer.

                 Separado do aviso comum porque aquele e substituido a cada
                 operacao. Aqui moram duas coisas que nao podem sumir: o motivo
                 de a ativacao nao ter sido aceita, e o fato de a politica
                 corporativa nao ter sido verificada - que some da vista
                 justamente enquanto a IA funciona bem e ninguem tem motivo
                 para reler nada.

                 Cor de aviso, e nao de texto comum: ele diz que a IA esta
                 ligada por decisao do usuario sobre uma politica que ninguem
                 conferiu. Isso nao pode ter o mesmo peso visual de um rodape
                 qualquer. -->
            <Border Grid.Row="2"
                    Visibility="{Binding TemAvisoDaAtivacao, Converter={StaticResource BoolToVis},
                                         FallbackValue=Collapsed}"
                    Background="{DynamicResource Brush.Surface.2}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <TextBlock Text="{Binding AvisoDaAtivacao}"
                           Style="{DynamicResource Text.Muted}"
                           Foreground="{DynamicResource Brush.Warning}"
                           FontWeight="SemiBold" TextWrapping="Wrap"
                           AutomationProperties.Name="Situacao da ativacao da IA" />
            </Border>
        </Grid>
    </Border>
</UserControl>
