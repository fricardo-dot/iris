<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        DEPENDENCIA EXPLICITA.

        Este arquivo consome chaves de Tokens.xaml dentro de ControlTemplate
        e BasedOn, e esses dois resolvem NA HORA DO PARSE : so enxergam o
        proprio dicionario e os que ele mesmo mescla. Setter.Value e adiado e
        acha o irmao pela pilha de recursos ambiente, e foi por isso que
        Font.Ui funcionava e Radius.Control nao.

        Enquanto a dependencia era implicita, este arquivo so carregava dentro
        de Application.Resources. Avulso : que e como um teste veste um
        controle, sem Application : ele lancava, e o sintoma aparecia longe.

        O WPF cacheia dicionario por URI, entao mesclar de novo nao duplica.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--
        Árvore de pastas. Estilizada agora porque é o marco em que ela
        aparece — a regra do projeto é estilizar cada controle no marco que
        o traz, não antes.

        Linha enxuta de propósito: sem sombra, sem gradiente, sem ícone por
        linha. Uma pasta com centenas de filhas multiplica tudo que estiver
        no template.
    -->

    <!-- Seta de expansão. Sem ela o usuário não sabe o que tem filho. -->
    <Style x:Key="TreeExpander" TargetType="ToggleButton">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <!-- O TreeViewItem controla expansão pelo teclado; a seta é só
             ponteiro, e não deve entrar na ordem de tabulação. -->
        <Setter Property="AutomationProperties.IsOffscreenBehavior" Value="Offscreen" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Glifo" Text="&#xE76C;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="8"
                                   Foreground="{DynamicResource Brush.Text.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Substitui a transformação inteira: um
                             RotateTransform nomeado dentro de
                             TextBlock.RenderTransform não é alcançável por
                             TargetName de trigger. -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glifo" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glifo" Property="Foreground"
                                    Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FolderTreeItem" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
        <!-- TreeView.SelectedItem é somente leitura: ligar a seleção ao
             ViewModel passa obrigatoriamente por aqui. -->
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <!-- Grid, não StackPanel: um StackPanel mede os filhos
                         com altura infinita, o que faz o ItemsPresenter
                         realizar todos os descendentes e anula a
                         virtualização hierárquica. -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="Linha" Grid.Row="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="4,5" Margin="0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ToggleButton x:Name="Expander" Grid.Column="0"
                                              Style="{StaticResource TreeExpander}"
                                              IsChecked="{Binding IsExpanded,
                                                          RelativeSource={RelativeSource TemplatedParent},
                                                          Mode=TwoWay}"
                                              Visibility="Collapsed" />

                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <ItemsPresenter x:Name="Filhos" Grid.Row="1"
                                        Margin="14,0,0,0" Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- CanExpand, e não HasItems: a seta precisa
                             aparecer ANTES de os filhos existirem, senão
                             não há como pedir para carregá-los. Era o que
                             faltava para a pasta expandir. -->
                        <DataTrigger Binding="{Binding CanExpand}" Value="True">
                            <Setter TargetName="Expander" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Filhos" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="Linha">
                            <Setter TargetName="Linha" Property="Background"
                                    Value="{DynamicResource Brush.Surface.2}" />
                        </Trigger>
                        <!-- Selecionado usa a superfície de acento, não o
                             acento cheio: uma linha inteira em azul forte
                             cansa num painel que fica sempre na tela. -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Linha" Property="Background"
                                    Value="{DynamicResource Brush.Accent.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                        </Trigger>
                        <!-- Só a COR da borda muda no foco. Mudar a
                             espessura empurraria o conteúdo e o texto
                             pularia de lugar. -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Linha" Property="BorderBrush"
                                    Value="{DynamicResource Brush.Focus}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="FolderTree" TargetType="TreeView">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource FolderTreeItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    </Style>

</ResourceDictionary>
