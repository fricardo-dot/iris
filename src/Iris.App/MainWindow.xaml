<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:model="clr-namespace:Iris.Model;assembly=Iris.Model"
        xmlns:app="clr-namespace:Iris.App"
        Title="Iris"
        Height="700" Width="1180"
        MinHeight="480" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Brush.Background}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        Barra de título própria: sem ícone e sem o nome do programa. Ambos
        continuam existindo NA JANELA (Title e Icon), e portanto na barra de
        tarefas, no Alt+Tab e para a acessibilidade — só não são desenhados.

        WindowChrome, e não WindowStyle=None sozinho: é o que preserva
        arrastar, Aero Snap, duplo clique para maximizar, bordas de resize e
        Win+Setas.
    -->
    <WindowChrome.WindowChrome>
        <!--
            GlassFrameThickness=1, não 0. Com 0 o DWM para de compor a
            moldura, e a janela perde a sombra e os cantos arredondados do
            Windows 11.
        -->
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibility x:Key="NotBoolToVis" />

        <!-- A cor do ponto NUNCA é o único sinal: o texto ao lado diz o
             mesmo. Vale para quem não distingue as cores e para quando o
             ponto é pequeno demais para se notar. -->
        <Style x:Key="StatusDotState" TargetType="Ellipse"
               BasedOn="{StaticResource StatusDot}">
            <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Connection.State}" Value="{x:Static model:SessionState.Connected}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Connection.State}" Value="{x:Static model:SessionState.Busy}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Connection.State}" Value="{x:Static model:SessionState.Reconnecting}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Connection.State}" Value="{x:Static model:SessionState.Unavailable}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Linha da pasta: nome à esquerda, não lidos à direita. Peso maior
             quando há não lidos, em vez de pintar a linha inteira. -->
        <!--
            HierarchicalDataTemplate, nao DataTemplate. Sem ItemsSource aqui,
            o TreeView nunca fica sabendo que existem filhos: nao desenha
            seta, nao cria os nos, e a pasta simplesmente nao expande. Era
            exatamente o defeito relatado.
        -->
        <HierarchicalDataTemplate x:Key="FolderNodeTemplate"
                                  ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Body}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="1" Text="{Binding UnreadCount}"
                           Margin="8,0,6,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Brush.Accent}"
                           Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}" />

                <!-- Sem isto, expandir uma pasta lenta mostra um ramo vazio
                     e o usuario nao sabe se esta carregando ou se acabou. -->
                <TextBlock Grid.Column="1" Text="…"
                           Margin="8,0,6,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </HierarchicalDataTemplate>

        <!--
            Linha da mensagem. Arvore visual rasa de proposito: cada elemento
            aqui e multiplicado por cada linha visivel.

            Nao lida usa PESO, nao cor de fundo — pintar a linha inteira
            cansaria numa lista que fica sempre aberta.
        -->
        <DataTemplate x:Key="MessageRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding SenderName}"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="&#xE723;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" Margin="0,0,6,0"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               ToolTip="Tem anexo"
                               Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ReceivedTime, StringFormat='{}{0:dd/MM HH:mm}'}"
                               FontFamily="{StaticResource Font.Ui}"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Subject}"
                           Margin="0,3,0,0"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Subject}" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ============ Barra de título ============ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface.1}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sem nome e sem icone aqui: o requisito era que
                         so a barra de tarefas os mostrasse, e a versao
                         anterior ainda desenhava "Iris". Window.Title segue
                         atendendo taskbar, Alt+Tab e acessibilidade.
                         As colunas 0 e 1 sao area continua de arrasto. -->

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                        <Ellipse Style="{StaticResource StatusDotState}" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding Connection.StatusLabel}"
                                   Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                                Content="&#xE921;" ToolTip="Minimizar"
                                AutomationProperties.Name="Minimizar" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                                Content="&#xE922;" ToolTip="Maximizar"
                                AutomationProperties.Name="Maximizar" />
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionButton.Close}"
                                Content="&#xE8BB;" ToolTip="Fechar"
                                AutomationProperties.Name="Fechar" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Conteúdo: pastas | lista | leitura ============ -->
            <Grid Grid.Row="1"
                  Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="200" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Pastas -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PASTAS"
                                   Style="{StaticResource Text.Muted}"
                                   FontSize="{StaticResource Font.Size.Caption}"
                                   Margin="16,16,16,8" />

                        <TreeView Grid.Row="1"
                                  Style="{StaticResource FolderTree}"
                                  ItemsSource="{Binding Folders.Roots}"
                                  ItemTemplate="{StaticResource FolderNodeTemplate}"
                                  Margin="8,0,8,8">
                            <TreeView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </TreeView.ItemsPanel>
                        </TreeView>

                        <TextBlock Grid.Row="1" Text="Carregando pastas…"
                                   Style="{StaticResource Text.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,16,0,0"
                                   Visibility="{Binding Folders.IsLoading, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="1" Text="{Binding Folders.ErrorMessage}"
                                   Style="{StaticResource Text.Muted}"
                                   Foreground="{DynamicResource Brush.Error}"
                                   TextWrapping="Wrap" Margin="16,16,16,0"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding Folders.HasError, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- Alvo de 6 DIP com a linha de 1 DIP desenhada por
                     baixo: visualmente fino, praticavel com o mouse. Um
                     splitter de 1 DIP e correto no desenho e pessimo de
                     acertar. -->
                <Border Grid.Column="1" Width="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Border.Subtle}" />
                <GridSplitter Grid.Column="1" Width="6"
                              HorizontalAlignment="Center"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"
                              AutomationProperties.Name="Redimensionar painel de pastas" />

                <!-- Lista de mensagens. A leitura chega no marco 1.4. -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,14,16,10"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding Messages.FolderName}"
                                   Style="{StaticResource Text.Title}"
                                   FontSize="{StaticResource Font.Size.Subtitle}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <ListBox Grid.Row="1"
                             Style="{StaticResource MessageList}"
                             ItemsSource="{Binding Messages.Messages}"
                             SelectedItem="{Binding Messages.Selected, Mode=TwoWay}"
                             ItemTemplate="{StaticResource MessageRowTemplate}" />

                    <!-- Nenhuma pasta escolhida ainda -->
                    <TextBlock Grid.Row="1" Text="Selecione uma pasta"
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Messages.IsEmpty, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="1" Text="{Binding Messages.ErrorMessage}"
                               Style="{StaticResource Text.Muted}"
                               Foreground="{DynamicResource Brush.Error}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Messages.HasError, Converter={StaticResource BoolToVis}}" />

                    <!-- Rodape: e aqui que o criterio de aceite do 1.3 fica
                         verificavel olhando a tela, em vez de por impressao. -->
                    <Border Grid.Row="2" Padding="16,8"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="{Binding Messages.StatusLine}"
                                       Style="{StaticResource Text.Muted}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="carregando…" Style="{StaticResource Text.Muted}"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Visibility="{Binding Messages.IsLoading, Converter={StaticResource BoolToVis}}" />
                                <Button Content="Carregar mais"
                                        Style="{StaticResource Button.Secondary}"
                                        Padding="10,4"
                                        FontSize="{StaticResource Font.Size.Small}"
                                        Command="{Binding Messages.LoadMoreCommand}"
                                        Visibility="{Binding Messages.HasMore, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ Card de conexão ============ -->
            <!-- Ocupa a janela só enquanto não há sessão. Com sessão, some e
                 dá lugar ao conteúdo; o indicador da barra continua contando
                 o estado sem trocar a tela a cada oscilação. -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowContent, Converter={StaticResource NotBoolToVis}}">
                <StackPanel>

                    <Border Width="56" Height="56"
                            CornerRadius="{StaticResource Radius.Card}"
                            Background="{DynamicResource Brush.Accent.Surface}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="◈" FontSize="26"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding Connection.Headline}"
                               Style="{StaticResource Text.Title}"
                               TextAlignment="Center" Margin="0,20,0,0" />

                    <TextBlock Text="{Binding Connection.Explanation}"
                               Style="{StaticResource Text.Secondary}"
                               TextAlignment="Center" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,24,0,0">
                        <Button Style="{StaticResource Button.Primary}"
                                Content="Abrir o Outlook"
                                Command="{Binding Connection.OpenOutlookCommand}"
                                Visibility="{Binding Connection.ShowOpenOutlook, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Verificar novamente"
                                Command="{Binding Connection.RetryCommand}"
                                IsDefault="True" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Muted}" TextAlignment="Center"
                               Margin="0,20,0,0"
                               Text="{Binding Connection.Detail}" />

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
