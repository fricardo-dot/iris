<Window xmlns:local="clr-namespace:Iris.App.Views" x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:model="clr-namespace:Iris.Model;assembly=Iris.Model"
        xmlns:app="clr-namespace:Iris.App"
        Title="Iris"
        Height="740" Width="1440"
        MinHeight="520" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource Brush.Background}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <!--
        Barra de título própria: sem ícone e sem o nome do programa. Ambos
        continuam existindo NA JANELA (Title e Icon), e portanto na barra de
        tarefas, no Alt+Tab e para a acessibilidade — só não são desenhados.

        WindowChrome, e não WindowStyle=None sozinho: é o que preserva
        arrastar, Aero Snap, duplo clique para maximizar, bordas de resize e
        Win+Setas.
    -->
    <WindowChrome.WindowChrome>
        <!--
            GlassFrameThickness=1, não 0. Com 0 o DWM para de compor a
            moldura, e a janela perde a sombra e os cantos arredondados do
            Windows 11.
        -->
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="1"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <app:CorDaEspera x:Key="CorDaEspera" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <app:InverseBoolToVisibility x:Key="NotBoolToVis" />
        <app:NullToVisibility x:Key="NullToVis" />

        <!-- A cor do ponto NUNCA é o único sinal: o texto ao lado diz o
             mesmo. Vale para quem não distingue as cores e para quando o
             ponto é pequeno demais para se notar. -->
        <Style x:Key="StatusDotState" TargetType="Ellipse"
               BasedOn="{StaticResource StatusDot}">
            <Setter Property="Fill" Value="{DynamicResource Brush.Text.Muted}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Connection.State}" Value="{x:Static model:SessionState.Connected}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Connection.State}" Value="{x:Static model:SessionState.Busy}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Connection.State}" Value="{x:Static model:SessionState.Reconnecting}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Connection.State}" Value="{x:Static model:SessionState.Unavailable}">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Error}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Linha da pasta: nome à esquerda, não lidos à direita. Peso maior
             quando há não lidos, em vez de pintar a linha inteira. -->
        <!--
            HierarchicalDataTemplate, nao DataTemplate. Sem ItemsSource aqui,
            o TreeView nunca fica sabendo que existem filhos: nao desenha
            seta, nao cria os nos, e a pasta simplesmente nao expande. Era
            exatamente o defeito relatado.
        -->
        <HierarchicalDataTemplate x:Key="FolderNodeTemplate"
                                  ItemsSource="{Binding Children}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Name}"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Body}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Name}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Column="1" Text="{Binding UnreadCount}"
                           Margin="8,0,6,0" VerticalAlignment="Center"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Brush.Accent}"
                           Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}" />

                <!-- Sem isto, expandir uma pasta lenta mostra um ramo vazio
                     e o usuario nao sabe se esta carregando ou se acabou. -->
                <TextBlock Grid.Column="1" Text="…"
                           Margin="8,0,6,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.Text.Muted}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </HierarchicalDataTemplate>

        <!--
            Linha da mensagem. Arvore visual rasa de proposito: cada elemento
            aqui e multiplicado por cada linha visivel.

            Nao lida usa PESO, nao cor de fundo — pintar a linha inteira
            cansaria numa lista que fica sempre aberta.
        -->
        <DataTemplate x:Key="MessageRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding SenderName}"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{DynamicResource Brush.Text.Primary}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnread}" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="&#xE723;"
                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="11" Margin="0,0,6,0"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               ToolTip="Tem anexo"
                               Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding ReceivedTime, StringFormat='{}{0:dd/MM HH:mm}'}"
                               FontFamily="{StaticResource Font.Ui}"
                               FontSize="{StaticResource Font.Size.Small}"
                               Foreground="{DynamicResource Brush.Text.Muted}" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding Subject}"
                           Margin="0,3,0,0"
                           FontFamily="{StaticResource Font.Ui}"
                           FontSize="{StaticResource Font.Size.Small}"
                           Foreground="{DynamicResource Brush.Text.Secondary}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Subject}" />
            </Grid>
        </DataTemplate>
        <!-- UMA LINHA DA FILA DE RESPOSTAS.

             OS DIAS APARECEM POR EXTENSO, ao lado da cor. A faixa e um corte
             sobre um numero, e quem discorda do corte precisa conseguir
             conferir o numero — senao a cor vira a unica coisa dita, e ela
             nao explica de onde veio.

             As tres acoes ficam na linha, e nao num menu: "nao exige
             resposta" e o que limpa a fila, e acao escondida nao limpa nada.

             O ESTADO E TEXTO, e diz "Possivel resposta" e nao "Precisa de
             voce": o Iris sabe quem falou por ultimo, e nao se aquilo pede
             resposta. -->
        <DataTemplate x:Key="Fila.Linha">
            <Border BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1" Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Espera}"
                               MinWidth="90" VerticalAlignment="Center"
                               FontFamily="Consolas"
                               Foreground="{Binding Faixa, Converter={StaticResource CorDaEspera}}"
                               AutomationProperties.Name="Tempo de espera" />

                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                        <TextBlock Text="{Binding Quem}"
                                   Style="{DynamicResource Text.Body}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Assunto}"
                                   Style="{DynamicResource Text.Muted}"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Estado}"
                                   Style="{DynamicResource Text.Muted}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="Abrir"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding ResponderCommand}"
                                AutomationProperties.Name="Abrir a mensagem" />
                        <Button Content="Não exige resposta"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding DispensarCommand}"
                                Margin="6,0,0,0"
                                AutomationProperties.Name="Dispensar esta conversa" />
                        <Button Content="Ignorar remetente"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding IgnorarRemetenteCommand}"
                                Margin="6,0,0,0"
                                ToolTip="Conversas encerradas por este remetente deixam de aparecer"
                                AutomationProperties.Name="Ignorar este remetente" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Border x:Name="RootBorder">
        <Grid>
            <!-- QUATRO LINHAS, E A QUARTA NASCEU DE UM DEFEITO.

                 A faixa do acervo e a faixa da IA moravam as duas na linha 2.
                 Num Grid isso significa EMPILHADAS, e a da IA - declarada
                 depois, e com fundo proprio - pintava por cima. A do acervo
                 nunca foi vista na tela, e a pendencia da Fase 2 que dizia
                 isso nao era falta de dado: era esta linha faltando.

                 Ninguem notou por anos porque a faixa do acervo so aparecia
                 quando havia ressalva, e a da IA cobria justamente quando
                 aparecia. Duas visibilidades condicionais escondendo uma
                 sobreposicao. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <!-- O acervo. -->
                <RowDefinition Height="Auto" />
                <!-- A IA. -->
                <RowDefinition Height="Auto" />
                <!-- Os contatos. Linha propria pelo mesmo motivo das tarefas:
                     a pasta pessoal de Contatos tambem fica fora da arvore. -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Barra de título ============ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface.1}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Sem nome e sem icone aqui: o requisito era que
                         so a barra de tarefas os mostrasse, e a versao
                         anterior ainda desenhava "Iris". Window.Title segue
                         atendendo taskbar, Alt+Tab e acessibilidade.
                         A coluna 1 continua sendo area de arrasto. -->

                    <!-- Acoes de composicao. Ficam na barra de titulo
                         porque a alternativa era uma segunda faixa so para
                         elas, roubando altura de onde o conteudo esta.
                         Somem sem sessao: oferecer "Nova mensagem" com o
                         Outlook fechado seria prometer o que nao da. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="12,0,0,0"
                                Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                        <Button Style="{StaticResource Toolbar.Button}"
                                Command="{Binding NewMessageCommand}"
                                ToolTip="Nova mensagem"
                                AutomationProperties.Name="Nova mensagem">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;" FontSize="12" Margin="0,0,7,0"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Nova" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Margin="8,10" VerticalAlignment="Stretch"
                                Background="{DynamicResource Brush.Border.Subtle}" />

                        <Button Style="{StaticResource Toolbar.Button}"
                                Command="{Binding ReplyCommand}"
                                Content="Responder"
                                ToolTip="Responder ao remetente"
                                AutomationProperties.Name="Responder" />
                        <Button Style="{StaticResource Toolbar.Button}"
                                Command="{Binding ReplyAllCommand}"
                                Content="Responder a todos"
                                AutomationProperties.Name="Responder a todos" />
                        <Button Style="{StaticResource Toolbar.Button}"
                                Command="{Binding ForwardCommand}"
                                Content="Encaminhar"
                                AutomationProperties.Name="Encaminhar" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Margin="0,0,12,0">
                        <!-- A LUPA. A busca no acervo era uma faixa fixa embaixo
                             da janela, ocupando altura o tempo todo para uma
                             coisa que se usa de vez em quando. Aqui ela e um
                             botao, e o painel abre por cima.

                             Segoe MDL2 E721 e a lupa do proprio Windows: o
                             mesmo simbolo que o usuario ja reconhece na barra
                             de tarefas e no Explorer. -->
                        <Button Style="{StaticResource CaptionButton}"
                                Content="&#xE721;"
                                Command="{Binding AlternarBuscaCommand}"
                                ToolTip="{Binding RotuloDaBusca}"
                                Margin="0,0,10,0"
                                AutomationProperties.Name="{Binding RotuloDaBusca}" />
                        <!-- TAREFAS e CONTATOS, o mesmo padrao da lupa.

                             Segoe MDL2: E8FD e a lista, E77B e o contato. Sao
                             os simbolos do proprio Windows, e nao desenho meu:
                             icone que o usuario ja viu em outro lugar nao
                             precisa ser aprendido. -->
                        <!-- A FILA DE RESPOSTAS. E8BD e o relogio: a pergunta
                             desta tela e "ha quanto tempo", e nao "o que". -->
                        <Button Style="{StaticResource CaptionButton}"
                                Content="&#xE823;"
                                Command="{Binding AlternarFilaCommand}"
                                ToolTip="Quem falou por último em cada conversa"
                                AutomationProperties.Name="Abrir ou fechar a fila de respostas" />
                        <!-- A CAIXA DIVIDIDA. E8FD e a lista com marcadores: a
                             pergunta desta tela e "de que tipo", e nao "quando". -->
                        <Button Style="{StaticResource CaptionButton}"
                                Content="&#xE8A9;"
                                Command="{Binding AlternarCaixasCommand}"
                                ToolTip="A caixa dividida por rótulo"
                                AutomationProperties.Name="Abrir ou fechar a caixa dividida" />
                        <Button Style="{StaticResource CaptionButton}"
                                Content="&#xE8FD;"
                                Command="{Binding AlternarTarefasCommand}"
                                ToolTip="Tarefas"
                                AutomationProperties.Name="Abrir ou fechar as tarefas" />
                        <Button Style="{StaticResource CaptionButton}"
                                Content="&#xE77B;"
                                Command="{Binding AlternarContatosCommand}"
                                ToolTip="Contatos"
                                Margin="0,0,10,0"
                                AutomationProperties.Name="Abrir ou fechar os contatos" />
                        <Ellipse Style="{StaticResource StatusDotState}" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding Connection.StatusLabel}"
                                   Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}"
                                Content="&#xE921;" ToolTip="Minimizar"
                                AutomationProperties.Name="Minimizar" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}"
                                Content="&#xE922;" ToolTip="Maximizar"
                                AutomationProperties.Name="Maximizar" />
                        <Button x:Name="CloseButton" Style="{StaticResource CaptionButton.Close}"
                                Content="&#xE8BB;" ToolTip="Fechar"
                                AutomationProperties.Name="Fechar" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Conteúdo: pastas | lista | leitura ============ -->
            <Grid Grid.Row="1"
                  Visibility="{Binding ShowContent, Converter={StaticResource BoolToVis}}">
                <!-- Pastas | lista | leitura. A lista tem largura propria e
                     limites: deixa-la elastica faria a leitura sumir numa
                     janela estreita, e o leitor e onde o tempo e gasto. -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="200" MaxWidth="320" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="420" MinWidth="320" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- Pastas -->
                <Border Grid.Column="0" Background="{DynamicResource Brush.Surface.1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="PASTAS"
                                   Style="{StaticResource Text.Muted}"
                                   FontSize="{StaticResource Font.Size.Caption}"
                                   Margin="16,16,16,8" />

                        <TreeView Grid.Row="1"
                                  Style="{StaticResource FolderTree}"
                                  ItemsSource="{Binding Folders.Roots}"
                                  ItemTemplate="{StaticResource FolderNodeTemplate}"
                                  Margin="8,0,8,8">
                            <TreeView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </TreeView.ItemsPanel>
                        </TreeView>

                        <TextBlock Grid.Row="1" Text="Carregando pastas…"
                                   Style="{StaticResource Text.Muted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top"
                                   Margin="0,16,0,0"
                                   Visibility="{Binding Folders.IsLoading, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="1" Text="{Binding Folders.ErrorMessage}"
                                   Style="{StaticResource Text.Muted}"
                                   Foreground="{DynamicResource Brush.Error}"
                                   TextWrapping="Wrap" Margin="16,16,16,0"
                                   VerticalAlignment="Top"
                                   Visibility="{Binding Folders.HasError, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <!-- Alvo de 6 DIP com a linha de 1 DIP desenhada por
                     baixo: visualmente fino, praticavel com o mouse. Um
                     splitter de 1 DIP e correto no desenho e pessimo de
                     acertar. -->
                <Border Grid.Column="1" Width="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Border.Subtle}" />
                <GridSplitter Grid.Column="1" Width="6"
                              HorizontalAlignment="Center"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"
                              AutomationProperties.Name="Redimensionar painel de pastas" />

                <!-- Lista de mensagens. A leitura chega no marco 1.4. -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,14,16,10"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding Messages.FolderName}"
                                   Style="{StaticResource Text.Title}"
                                   FontSize="{StaticResource Font.Size.Subtitle}"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>

                    <ListBox Grid.Row="1"
                             Style="{StaticResource MessageList}"
                             ItemsSource="{Binding Messages.Messages}"
                             SelectedItem="{Binding Messages.Selected, Mode=TwoWay}"
                             ItemTemplate="{StaticResource MessageRowTemplate}" />

                    <!-- Tres estados distintos, nao um so: "escolha uma
                         pasta", "esta pasta esta vazia" e "deu erro" diziam
                         a mesma coisa antes, e uma caixa legitimamente
                         vazia exibia "Selecione uma pasta". -->
                    <TextBlock Grid.Row="1" Text="Selecione uma pasta"
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Messages.ShowSelectPrompt, Converter={StaticResource BoolToVis}}" />

                    <!-- O TEXTO E CALCULADO, e nao fixo. Ele dizia sempre
                         "Esta pasta esta vazia", inclusive quando a leitura
                         tinha PERDIDO itens: a mesma tela mostrava "Esta pasta
                         esta vazia" no meio e "0 de 1 - 1 item ignorado" no
                         rodape. Ver EmptyMessage. -->
                    <TextBlock Grid.Row="1" Text="{Binding Messages.EmptyMessage}"
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Messages.ShowEmptyFolder, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Grid.Row="1" Text="{Binding Messages.ErrorMessage}"
                               Style="{StaticResource Text.Muted}"
                               Foreground="{DynamicResource Brush.Error}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Messages.HasError, Converter={StaticResource BoolToVis}}" />

                    <!-- Rodape: e aqui que o criterio de aceite do 1.3 fica
                         verificavel olhando a tela, em vez de por impressao. -->
                    <Border Grid.Row="2" Padding="16,8"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Messages.StatusLine}"
                                           Style="{StaticResource Text.Muted}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <!-- O ACERVO, EM UM ICONE.

                                         Ele era um bloco: rotulo ACERVO, botao "Varrer esta
                                         pasta", a contagem, e duas linhas explicando que pasta
                                         sem acervo publicado nao quer dizer pasta nao varrida.
                                         Quatro linhas de rodape para uma acao que se usa uma vez
                                         por pasta, comendo altura da lista de mensagens.

                                         Agora e um icone e um numero, na MESMA linha do
                                         "13 de 13" — que era a razao de o acervo ter vindo para
                                         ca em 30/08: as duas contagens falam da mesma pasta, uma
                                         ao vivo e a outra do cache, e a diferenca entre elas tem
                                         de caber num olhar.

                                         A CONTAGEM FICA VISIVEL, e a explicacao vai para a dica.
                                         Numero sozinho seria afirmacao sobre a CAIXA; ele e sobre
                                         o CACHE, e a ressalva e o que diz qual dos dois. Esconder
                                         a contagem tambem economizaria espaco e tiraria o unico
                                         motivo de o icone estar aqui em vez de num menu. -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                Margin="0,0,12,0"
                                                Visibility="{Binding MostrarAcervo, Converter={StaticResource BoolToVis},
                                                                     FallbackValue=Collapsed}">
                                        <Button Style="{StaticResource CaptionButton}"
                                                Width="26" Height="22" FontSize="13"
                                                Content="&#xE81C;"
                                                Command="{Binding Acervo.VarrerCommand}"
                                                AutomationProperties.Name="Varrer esta pasta">
                                            <Button.ToolTip>
                                                <StackPanel MaxWidth="380">
                                                    <TextBlock Text="Varrer esta pasta"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="Le a pasta inteira e guarda o que viu no cache."
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <!-- A RESSALVA MORA NA DICA, e nao sumiu: ela e o que
                                                         separa "esta pasta nao tem acervo" de "ninguem
                                                         tentou varrer esta pasta". -->
                                                    <TextBlock Text="{Binding Acervo.Ressalva}"
                                                               TextWrapping="Wrap" Margin="0,6,0,0"
                                                               Visibility="{Binding Acervo.Ressalva,
                                                                                    Converter={StaticResource NullToVis},
                                                                                    FallbackValue=Collapsed}" />
                                                </StackPanel>
                                            </Button.ToolTip>
                                        </Button>
                                        <TextBlock Text="{Binding Acervo.Itens}"
                                                   Style="{StaticResource Text.Muted}"
                                                   Margin="4,0,0,0" VerticalAlignment="Center"
                                                   ToolTip="Itens guardados no acervo desta pasta"
                                                   AutomationProperties.Name="Itens guardados no acervo" />
                                        <!-- Varrer bloqueia e demora: sem sinal na tela, "esta
                                             lendo" e "travou" sao a mesma coisa para quem olha. -->
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="60" Height="3" Margin="8,0,0,0"
                                                     BorderThickness="0"
                                                     Background="{DynamicResource Brush.Surface.3}"
                                                     Foreground="{DynamicResource Brush.Accent}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding Acervo.Varrendo,
                                                                  Converter={StaticResource BoolToVis},
                                                                  FallbackValue=Collapsed}"
                                                     AutomationProperties.Name="Varrendo" />

                                        <!-- CLASSIFICAR, AO LADO DE VARRER, e nao num menu.

                                             As duas operam a MESMA pasta e sao a mesma
                                             sequencia: varrer guarda o que existe, classificar
                                             poe rotulo no que foi guardado. Separa-las de tela
                                             faria a segunda parecer independente da primeira,
                                             e ela nao e: sem acervo nao ha o que classificar.

                                             E8FA e a etiqueta. O botao NAO some sem ativacao:
                                             sem ela a passagem roda, o portao nega cada lote e a
                                             frase explica. Botao apagado sem motivo foi o
                                             defeito que a faixa da IA ja teve. -->
                                        <Button Style="{StaticResource CaptionButton}"
                                                Width="26" Height="22" FontSize="13"
                                                Margin="8,0,0,0"
                                                Content="&#xE8FA;"
                                                Command="{Binding ClassificarPastaCommand}"
                                                AutomationProperties.Name="Classificar esta pasta com a IA">
                                            <Button.ToolTip>
                                                <StackPanel MaxWidth="380">
                                                    <TextBlock Text="Classificar esta pasta"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="Manda o corpo das mensagens ainda sem rotulo ao provedor, em lotes, e guarda o rotulo no cache."
                                                               TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="Nada e enviado por e-mail, e nada sai sem a autorizacao assinada."
                                                               TextWrapping="Wrap" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Button.ToolTip>
                                        </Button>
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="60" Height="3" Margin="8,0,0,0"
                                                     BorderThickness="0"
                                                     Background="{DynamicResource Brush.Surface.3}"
                                                     Foreground="{DynamicResource Brush.Accent}"
                                                     VerticalAlignment="Center"
                                                     Visibility="{Binding Classificando,
                                                                  Converter={StaticResource BoolToVis},
                                                                  FallbackValue=Collapsed}"
                                                     AutomationProperties.Name="Classificando" />
                                    </StackPanel>

                                    <TextBlock Text="carregando…" Style="{StaticResource Text.Muted}"
                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                               Visibility="{Binding Messages.IsLoading, Converter={StaticResource BoolToVis}}" />
                                    <Button Content="Carregar mais"
                                            Style="{StaticResource Button.Secondary}"
                                            Padding="10,4"
                                            FontSize="{StaticResource Font.Size.Small}"
                                            Command="{Binding Messages.LoadMoreCommand}"
                                            Visibility="{Binding Messages.HasMore, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </Grid>

                            <!-- A FALHA NAO VAI PARA DENTRO DA DICA.

                                 A ressalva explica um estado normal e cabe onde so
                                 se le quando se procura. Isto aqui e a atualizacao do
                                 acervo tendo FALHADO, e ninguem passa o mouse num icone
                                 para descobrir que algo quebrou. Custa zero linha
                                 enquanto nada quebra. -->
                            <!-- O DESFECHO DA CLASSIFICACAO FICA NA TELA, e nao numa dica.

                                 Ele diz quantas foram classificadas e, separadamente,
                                 quantas nao foram, e por que: lote recusado, rotulo
                                 inventado e mensagem que saiu da pasta sao problemas
                                 diferentes. Somados num "faltaram 30", nenhum deles seria
                                 acionavel. -->
                            <TextBlock Text="{Binding Classificacao}"
                                       Style="{StaticResource Text.Muted}"
                                       TextWrapping="Wrap" Margin="12,4,12,0"
                                       Visibility="{Binding TemClassificacao,
                                                            Converter={StaticResource BoolToVis},
                                                            FallbackValue=Collapsed}"
                                       AutomationProperties.Name="Resultado da classificacao" />

                            <TextBlock Text="{Binding Acervo.Travado}"
                                       TextWrapping="Wrap"
                                       FontSize="12" Margin="0,6,0,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Visibility="{Binding Acervo.Travado, Converter={StaticResource NullToVis},
                                                            FallbackValue=Collapsed}"
                                       AutomationProperties.Name="Falha na atualizacao do acervo" />

                        <!-- ==================== BUSCA ====================
                             Ela mora AQUI, junto do acervo, e nao junto da lista:
                             a lista le ao vivo do Outlook e a busca le do cache.
                             Poe-la ao lado da lista faria o usuario esperar que
                             ela procurasse na caixa, e ela procura no ACERVO:
                             so metadados, sem corpo, e so o que ja foi varrido.
                             Duas fontes diferentes com a mesma cara enganam em
                             silencio.

                             NAO se escreve aqui quanto tempo o acervo cobre. A
                             janela de 31 dias medida em 28/08 e do OUTLOOK, e o
                             cache foi desenhado para acumular alem dela. Fixar
                             "um mes" no comentario seria gravar como permanente
                             um numero que e do provedor e muda sozinho.

                             A ressalva fica visivel SEMPRE que houve busca, e
                             nao so quando ela nao acha: uma ressalva que so
                             aparece no vazio ensina a le-la como "nao achei", e
                             ela diz outra coisa - onde se procurou, com que
                             alcance, e que o corpo nao e procuravel. -->

                            <!-- O CACHE QUE NAO ABRE fica no mesmo lugar do acervo, e nao
                                numa faixa propria: e o mesmo assunto, e quando ele
                                aparece o outro nao aparece. Na grade raiz eles eram duas
                                bordas na mesma linha, cada uma com sua condicao,
                                esperando nao coincidir. Aqui empilham de verdade, um
                                embaixo do outro. -->
                            <!-- O cache que nao abre nao pode virar tela vazia silenciosa:
                                 vazio e indistinguivel de "nao ha nada guardado". -->
                            <Border Grid.Row="2"
                                    Visibility="{Binding AcervoIndisponivel, Converter={StaticResource NullToVis},
                                                         FallbackValue=Collapsed}"
                                    Background="{DynamicResource Brush.Surface.1}"
                                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                                    BorderThickness="0,1,0,0"
                                    Padding="16,8">
                                <TextBlock Text="{Binding AcervoIndisponivel}"
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           AutomationProperties.Name="Acervo indisponivel" />
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="3" Width="1"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush.Border.Subtle}" />
                <GridSplitter Grid.Column="3" Width="6"
                              HorizontalAlignment="Center"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext"
                              AutomationProperties.Name="Redimensionar lista" />

                <!-- ============ Leitura ============ -->
                <Grid Grid.Column="4" Background="{DynamicResource Brush.Surface.1}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Cabecalho -->
                    <Border Grid.Row="0" Padding="20,18,20,14"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding Detail.HasMessage, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding Detail.Subject}"
                                       Style="{StaticResource Text.Title}"
                                       FontSize="{StaticResource Font.Size.Subtitle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail.SenderLine}"
                                       Style="{StaticResource Text.Secondary}"
                                       Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Detail.RecipientLine}"
                                       Style="{StaticResource Text.Muted}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Anexos. Listar e leitura; abrir e decisao da UI com
                         confirmacao, porque abrir anexo executa conteudo
                         nao confiavel (F1-J). Por isso, aqui, so SALVAR. -->
                    <Border Grid.Row="1" Padding="20,10"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding Detail.HasAttachments, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Detail.Attachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Surface.3}"
                                            CornerRadius="{StaticResource Radius.Control}"
                                            Padding="10,6" Margin="0,0,8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE723;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="11" Margin="0,0,8,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                            <TextBlock Text="{Binding FileName}"
                                                       Style="{StaticResource Text.Body}"
                                                       FontSize="{StaticResource Font.Size.Small}"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="240"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileName}" />

                                            <!-- SALVAR, nao abrir. Abrir anexo executa
                                                 conteudo nao confiavel, e o Iris nao faz
                                                 isso por conta propria (F1-J). -->
                                            <Button Content="&#xE74E;"
                                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    FontSize="11"
                                                    Margin="10,0,0,0" Padding="6,2"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Button.Secondary}"
                                                    ToolTip="Salvar anexo"
                                                    AutomationProperties.Name="Salvar anexo"
                                                    Command="{Binding DataContext.Detail.SaveAttachmentCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{Binding Detail.AttachmentStatus}"
                               Style="{StaticResource Text.Muted}"
                               Margin="20,0,20,8" VerticalAlignment="Bottom"
                               TextWrapping="Wrap"
                               Visibility="{Binding Detail.HasAttachmentStatus, Converter={StaticResource BoolToVis}}" />

                    <!-- Corpo, em TEXTO PURO nesta versao. HTML de e-mail e
                         conteudo hostil vindo de fora; o WebView2 endurecido
                         entra depois, com as travas verificaveis. -->
                    <!--
                        Sem ScrollViewer externo. Um ScrollViewer da altura
                        infinita ao conteudo, e o TextBox precisaria medir e
                        montar layout do corpo INTEIRO — com teto de 512 mil
                        caracteres e quebra de linha, isso congela a janela.
                        O TextBox rola sozinho, numa linha de altura definida.
                    -->
                    <Grid Grid.Row="2"
                          Visibility="{Binding Detail.HasMessage, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{DynamicResource Brush.Surface.3}"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="12,10" Margin="20,16,20,0"
                                Visibility="{Binding Detail.HasBodyNotice, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Detail.BodyNotice}"
                                       Style="{StaticResource Text.Secondary}" />
                        </Border>

                        <TextBox Grid.Row="1"
                                 Text="{Binding Detail.Body, Mode=OneWay}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource Brush.Text.Primary}"
                                 FontFamily="{StaticResource Font.Ui}"
                                 FontSize="{StaticResource Font.Size.Body}"
                                 TextWrapping="Wrap"
                                 Padding="20,16"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 IsTabStop="True"
                                 AutomationProperties.Name="Corpo da mensagem" />
                    </Grid>

                    <TextBlock Grid.Row="2" Text="Selecione uma mensagem"
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Detail.HasMessage, Converter={StaticResource NotBoolToVis}}" />

                    <TextBlock Grid.Row="2" Text="{Binding Detail.ErrorMessage}"
                               Style="{StaticResource Text.Muted}"
                               Foreground="{DynamicResource Brush.Error}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="20"
                               Visibility="{Binding Detail.HasError, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Grid>

            <!-- ============ Card de conexão ============ -->
            <!-- Ocupa a janela só enquanto não há sessão. Com sessão, some e
                 dá lugar ao conteúdo; o indicador da barra continua contando
                 o estado sem trocar a tela a cada oscilação. -->
            <Border Grid.Row="1" Style="{StaticResource Card}"
                    Width="480"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding ShowContent, Converter={StaticResource NotBoolToVis}}">
                <StackPanel>

                    <Border Width="56" Height="56"
                            CornerRadius="{StaticResource Radius.Card}"
                            Background="{DynamicResource Brush.Accent.Surface}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="◈" FontSize="26"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="{Binding Connection.Headline}"
                               Style="{StaticResource Text.Title}"
                               TextAlignment="Center" Margin="0,20,0,0" />

                    <TextBlock Text="{Binding Connection.Explanation}"
                               Style="{StaticResource Text.Secondary}"
                               TextAlignment="Center" Margin="0,10,0,0" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,24,0,0">
                        <Button Style="{StaticResource Button.Primary}"
                                Content="Abrir o Outlook"
                                Command="{Binding Connection.OpenOutlookCommand}"
                                Visibility="{Binding Connection.ShowOpenOutlook, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Secondary}"
                                Content="Verificar novamente"
                                Command="{Binding Connection.RetryCommand}"
                                IsDefault="True" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource Text.Muted}" TextAlignment="Center"
                               Margin="0,20,0,0"
                               Text="{Binding Connection.Detail}" />

                </StackPanel>
            </Border>

            <!-- ==================== Compositor ==================== -->
            <!--
                Cobre o conteudo, nao a barra de titulo: minimizar, maximizar
                e fechar a JANELA continuam alcancaveis com um rascunho
                aberto. Prender o usuario dentro do compositor seria trocar
                um problema de foco por um de saida.
            -->
            <!-- A FILA DE RESPOSTAS PENDENTES.

                 Mesmo padrao das outras tres: botao na barra, painel por cima,
                 clique fora fecha. Painel e nao faixa, mesmo sendo a tela que
                 se abre de manha: faixa fixa cobrando pendencia o dia inteiro
                 vira paisagem, e paisagem nao se le.

                 A FRASE VEM ANTES DAS LISTAS, e nao depois. Ela e a parte que
                 mais importa: lista vazia sem frase deixa o dono concluir "nao
                 tenho nada", e esse e o unico desfecho que esta tela nao pode
                 produzir por engano. As listas so aparecem quando a fila
                 conseguiu responder — zero linhas ao lado de "nao sei" seria
                 a contradicao na tela. -->
            <Grid Grid.Row="1" Panel.ZIndex="11"
                  Visibility="{Binding FilaAberta, Converter={StaticResource BoolToVis},
                                     FallbackValue=Collapsed}">

                <Rectangle Fill="#99000000">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding FecharFilaCommand}" />
                    </Rectangle.InputBindings>
                </Rectangle>

                <Border Background="{DynamicResource Brush.Surface.1}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        MaxWidth="900" Margin="28"
                        VerticalAlignment="Top"
                        Padding="20,16,20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="A ÚLTIMA PALAVRA DE CADA CONVERSA"
                                       Style="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center" />
                            <Button Content="Atualizar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Fila.AtualizarCommand}"
                                    Margin="16,0,0,0"
                                    AutomationProperties.Name="Reler a fila" />
                            <Button Content="Fechar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding FecharFilaCommand}"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Fechar a fila" />
                        </StackPanel>

                        <TextBlock Text="{Binding Fila.Frase}"
                                   Style="{DynamicResource Text.Body}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Situacao da fila" />

                        <TextBlock Text="{Binding Fila.Ressalva}"
                                   Style="{DynamicResource Text.Muted}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding Fila.TemRessalva,
                                                        Converter={StaticResource BoolToVis},
                                                        FallbackValue=Collapsed}"
                                   AutomationProperties.Name="O que ficou fora da fila" />

                        <StackPanel Visibility="{Binding Fila.Respondeu,
                                                         Converter={StaticResource BoolToVis},
                                                         FallbackValue=Collapsed}">

                            <!-- OS DOIS TITULOS DESCREVEM O FATO, e nao a obrigacao.

                                 "Quem esta esperando voce" afirma que alguem espera, e o
                                 Iris nao sabe disso: a questao pode ter sido resolvida
                                 por telefone, em reuniao, ou por um encaminhamento que
                                 virou outra conversa. O que ele sabe e quem escreveu por
                                 ultimo.

                                 A linha ja dizia "Possivel resposta"; a moldura e que
                                 afirmava mais que a linha. -->
                            <TextBlock Text="A ÚLTIMA É DELES" Margin="0,14,0,4"
                                       Style="{DynamicResource Text.Muted}" />
                            <ItemsControl ItemsSource="{Binding Fila.Minhas}"
                                          ItemTemplate="{StaticResource Fila.Linha}" />

                            <TextBlock Text="A ÚLTIMA É SUA" Margin="0,14,0,4"
                                       Style="{DynamicResource Text.Muted}" />
                            <ItemsControl ItemsSource="{Binding Fila.Deles}"
                                          ItemTemplate="{StaticResource Fila.Linha}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ A CAIXA DIVIDIDA (painel) ============

                 A LEGENDA VEM ANTES DAS GAVETAS, e e o mesmo motivo da fila:
                 gavetas bonitas dao a impressao de que tudo foi olhado. Se a
                 varredura classificou quarenta de novecentas, isso e falso, e o
                 dono so descobriria abrindo a ultima gaveta.

                 As gavetas vazias aparecem por padrao. "Nenhuma mensagem espera
                 voce" e "esta divisao nao existe" sao coisas diferentes, e uma
                 tela que so mostra gaveta com conteudo muda de forma a cada
                 varredura. -->
            <Grid Grid.Row="1" Panel.ZIndex="11"
                  Visibility="{Binding CaixasAberta, Converter={StaticResource BoolToVis},
                                     FallbackValue=Collapsed}">

                <Rectangle Fill="#99000000">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding FecharCaixasCommand}" />
                    </Rectangle.InputBindings>
                </Rectangle>

                <Border Background="{DynamicResource Brush.Surface.1}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        MaxWidth="900" MaxHeight="640" Margin="28"
                        VerticalAlignment="Top"
                        Padding="20,16,20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="A CAIXA DIVIDIDA"
                                       Style="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center" />
                            <Button Content="Atualizar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Caixas.AtualizarCommand}"
                                    Margin="16,0,0,0"
                                    AutomationProperties.Name="Reler a caixa dividida" />
                            <CheckBox Content="Mostrar gavetas vazias"
                                      IsChecked="{Binding Caixas.MostrarVazias}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"
                                      Foreground="{DynamicResource Brush.Text.Muted}"
                                      AutomationProperties.Name="Mostrar gavetas vazias" />
                            <Button Content="Fechar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding FecharCaixasCommand}"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Fechar a caixa dividida" />
                        </StackPanel>

                        <TextBlock Text="{Binding Caixas.Cobertura}"
                                   Style="{DynamicResource Text.Body}"
                                   TextWrapping="Wrap"
                                   AutomationProperties.Name="Cobertura da classificacao" />

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      MaxHeight="520" Margin="0,10,0,0">
                            <ItemsControl ItemsSource="{Binding Caixas.Gavetas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Nome}"
                                                           Style="{DynamicResource Text.Body}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Quantas}"
                                                           Style="{DynamicResource Text.Muted}"
                                                           Margin="8,0,0,0" />
                                            </StackPanel>

                                            <ItemsControl ItemsSource="{Binding Mensagens}"
                                                          Margin="10,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{DynamicResource Toolbar.Button}"
                                                                HorizontalContentAlignment="Left"
                                                                Command="{Binding AbrirCommand}"
                                                                Margin="0,1,0,1">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Quem}"
                                                                           Style="{DynamicResource Text.Muted}"
                                                                           MinWidth="140" />
                                                                <TextBlock Text="{Binding Assunto}"
                                                                           Style="{DynamicResource Text.Body}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ TAREFAS (painel) ============

                 Era uma faixa fixa no rodape da janela, numa linha propria
                 da grade, empurrando a lista de mensagens para cima o tempo
                 todo. Ela ja nascia com botao "Abrir", porque a pasta nem
                 aparece na arvore — entao o botao virou a barra de titulo, e
                 o resto virou painel.

                 O conteudo e o MESMO, inclusive as ressalvas. Elas nao sao
                 decoracao de faixa: no caso dos contatos, a ressalva do GAL e
                 a unica coisa que impede uma lista vazia de ser lida como
                 "nao ha contatos". -->
            <Grid Grid.Row="1" Panel.ZIndex="11"
                  Visibility="{Binding TarefasAberta, Converter={StaticResource BoolToVis},
                                     FallbackValue=Collapsed}">

                <Rectangle Fill="#99000000">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding FecharTarefasCommand}" />
                    </Rectangle.InputBindings>
                </Rectangle>

                <Border Background="{DynamicResource Brush.Surface.1}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        MaxWidth="900" Margin="28"
                        VerticalAlignment="Top"
                        Padding="20,16,20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="TAREFAS"
                                       Style="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center" />
                            <Button Content="Fechar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding FecharTarefasCommand}"
                                    Margin="16,0,0,0"
                                    AutomationProperties.Name="Fechar as tarefas" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="TAREFAS"
                                       Style="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center" />
                            <Button Content="Abrir"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Tarefas.AbrirCommand}"
                                    Margin="12,0,0,0"
                                    ToolTip="Le a pasta de tarefas do Outlook. Ela nao aparece na arvore de pastas."
                                    AutomationProperties.Name="Abrir as tarefas" />
                            <Button Content="Atualizar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Tarefas.AtualizarCommand}"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Atualizar as tarefas" />
                            <TextBlock Text="{Binding Tarefas.Resumo}"
                                       Style="{DynamicResource Text.Muted}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True"
                                         Width="90" Height="3" Margin="12,0,0,0"
                                         BorderThickness="0"
                                         Background="{DynamicResource Brush.Surface.3}"
                                         Foreground="{DynamicResource Brush.Accent}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding Tarefas.Carregando,
                                                      Converter={StaticResource BoolToVis},
                                                      FallbackValue=Collapsed}"
                                         AutomationProperties.Name="Lendo as tarefas" />
                        </StackPanel>

                        <!-- PROPOR e CRIAR: dois controles, e nunca um so. -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding Tarefas.TemPasta,
                                                 Converter={StaticResource BoolToVis},
                                                 FallbackValue=Collapsed}">
                            <TextBox Text="{Binding Tarefas.NovoAssunto, UpdateSourceTrigger=PropertyChanged}"
                                     Width="280"
                                     VerticalContentAlignment="Center"
                                     ToolTip="O que e para fazer"
                                     AutomationProperties.Name="Assunto da nova tarefa" />
                            <Button Content="Desta mensagem"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding ProporTarefaCommand}"
                                    Margin="6,0,0,0"
                                    ToolTip="Copia o assunto da mensagem selecionada para o campo. Nao cria nada, e nao usa a IA."
                                    AutomationProperties.Name="Propor tarefa desta mensagem" />
                            <Button Content="Criar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Tarefas.CriarCommand}"
                                    Margin="6,0,0,0"
                                    ToolTip="Cria a tarefa na pasta de tarefas do Outlook"
                                    AutomationProperties.Name="Criar a tarefa" />
                            <Button Content="Concluir"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Tarefas.ConcluirCommand}"
                                    Margin="18,0,0,0"
                                    ToolTip="Marca a tarefa selecionada como concluida"
                                    AutomationProperties.Name="Concluir a tarefa selecionada" />
                            <TextBlock Text="{Binding Tarefas.AvisoDaSelecionada}"
                                       Style="{DynamicResource Text.Muted}"
                                       TextWrapping="Wrap" MaxWidth="360"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       AutomationProperties.Name="Por que esta tarefa nao pode ser concluida aqui" />
                        </StackPanel>

                        <ListBox ItemsSource="{Binding Tarefas.Tarefas}"
                                 SelectedItem="{Binding Tarefas.Selecionada}"
                                 MaxHeight="150"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 AutomationProperties.Name="Tarefas lidas">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Prazo}"
                                                   Width="110"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding Assunto}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="420" />
                                        <!-- O aviso de atribuida fica na LINHA, e nao
                                             so no rodape: quem le a lista precisa
                                             saber quais linhas pertencem a uma
                                             negociacao da qual o Iris nao participa. -->
                                        <TextBlock Text="atribuida"
                                                   FontSize="11" Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                                   Visibility="{Binding Atribuida,
                                                                Converter={StaticResource BoolToVis},
                                                                FallbackValue=Collapsed}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="{Binding Tarefas.Erro}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.Error}"
                                   Visibility="{Binding Tarefas.TemErro,
                                                Converter={StaticResource BoolToVis},
                                                FallbackValue=Collapsed}"
                                   AutomationProperties.Name="Falha nas tarefas" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ CONTATOS (painel) ============

                 Era uma faixa fixa no rodape da janela, numa linha propria
                 da grade, empurrando a lista de mensagens para cima o tempo
                 todo. Ela ja nascia com botao "Abrir", porque a pasta nem
                 aparece na arvore — entao o botao virou a barra de titulo, e
                 o resto virou painel.

                 O conteudo e o MESMO, inclusive as ressalvas. Elas nao sao
                 decoracao de faixa: no caso dos contatos, a ressalva do GAL e
                 a unica coisa que impede uma lista vazia de ser lida como
                 "nao ha contatos". -->
            <Grid Grid.Row="1" Panel.ZIndex="11"
                  Visibility="{Binding ContatosAberta, Converter={StaticResource BoolToVis},
                                     FallbackValue=Collapsed}">

                <Rectangle Fill="#99000000">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding FecharContatosCommand}" />
                    </Rectangle.InputBindings>
                </Rectangle>

                <Border Background="{DynamicResource Brush.Surface.1}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        MaxWidth="900" Margin="28"
                        VerticalAlignment="Top"
                        Padding="20,16,20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="CONTATOS"
                                       Style="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center" />
                            <Button Content="Fechar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding FecharContatosCommand}"
                                    Margin="16,0,0,0"
                                    AutomationProperties.Name="Fechar os contatos" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="CONTATOS"
                                       Style="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center" />
                            <Button Content="Abrir"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Contatos.AbrirCommand}"
                                    Margin="12,0,0,0"
                                    ToolTip="Le a pasta pessoal de Contatos. Ela nao aparece na arvore de pastas."
                                    AutomationProperties.Name="Abrir os contatos" />
                            <Button Content="Atualizar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Contatos.AtualizarCommand}"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Atualizar os contatos" />
                            <TextBlock Text="{Binding Contatos.Resumo}"
                                       Style="{DynamicResource Text.Muted}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                            <ProgressBar IsIndeterminate="True"
                                         Width="90" Height="3" Margin="12,0,0,0"
                                         BorderThickness="0"
                                         Background="{DynamicResource Brush.Surface.3}"
                                         Foreground="{DynamicResource Brush.Accent}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding Contatos.Carregando,
                                                      Converter={StaticResource BoolToVis},
                                                      FallbackValue=Collapsed}"
                                         AutomationProperties.Name="Lendo os contatos" />
                        </StackPanel>

                        <!-- A RESSALVA, ACIMA DA LISTA E NAO ABAIXO.
                             Ela explica o que a lista NAO diz, e quem le de cima
                             para baixo precisa dela antes de tirar conclusao do
                             que ve, ou da falta do que ve. -->
                        <TextBlock Text="{Binding Contatos.Ressalva}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Visibility="{Binding Contatos.TemRessalva,
                                                Converter={StaticResource BoolToVis},
                                                FallbackValue=Collapsed}"
                                   AutomationProperties.Name="O que esta leitura de contatos nao alcanca" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                    Visibility="{Binding Contatos.TemPasta,
                                                 Converter={StaticResource BoolToVis},
                                                 FallbackValue=Collapsed}">
                            <TextBox Text="{Binding Contatos.NovoNome, UpdateSourceTrigger=PropertyChanged}"
                                     Width="170"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Nome do contato"
                                     AutomationProperties.Name="Nome do novo contato" />
                            <TextBox Text="{Binding Contatos.NovoEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Width="190" Margin="6,0,0,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Endereco de e-mail"
                                     AutomationProperties.Name="E-mail do novo contato" />
                            <TextBox Text="{Binding Contatos.NovaEmpresa, UpdateSourceTrigger=PropertyChanged}"
                                     Width="140" Margin="6,0,0,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Empresa"
                                     AutomationProperties.Name="Empresa do novo contato" />
                            <Button Content="Deste remetente"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding ProporContatoCommand}"
                                    Margin="6,0,0,0"
                                    ToolTip="Copia o remetente da mensagem selecionada para o formulario. Nao cria nada, e nao usa a IA."
                                    AutomationProperties.Name="Propor contato deste remetente" />
                            <Button Content="Criar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Contatos.CriarCommand}"
                                    Margin="6,0,0,0"
                                    ToolTip="Cria o contato na pasta pessoal de Contatos"
                                    AutomationProperties.Name="Criar o contato" />
                        </StackPanel>

                        <!-- O AVISO DE FICHA REPETIDA. Aviso, e nao recusa: o botao
                             "Criar" ao lado continua habilitado de proposito. -->
                        <TextBlock Text="{Binding Contatos.Aviso}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,6"
                                   Foreground="{DynamicResource Brush.Text.Secondary}"
                                   Visibility="{Binding Contatos.TemAviso,
                                                Converter={StaticResource BoolToVis},
                                                FallbackValue=Collapsed}"
                                   AutomationProperties.Name="Ja ha ficha com este endereco" />

                        <ItemsControl ItemsSource="{Binding Contatos.Contatos}"
                                      AutomationProperties.Name="Contatos lidos">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                        <TextBlock Text="{Binding Nome}"
                                                   Width="170" FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Email}"
                                                   Width="230" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        <TextBlock Text="{Binding Empresa}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="200"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding Contatos.Erro}"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.Error}"
                                   Visibility="{Binding Contatos.TemErro,
                                                Converter={StaticResource BoolToVis},
                                                FallbackValue=Collapsed}"
                                   AutomationProperties.Name="Falha nos contatos" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Busca no acervo ============

                 ERA UMA FAIXA FIXA, e ocupava altura o tempo todo para uma
                 coisa que se usa de vez em quando. Com a declaracao do diario
                 de buscas junto — que e um paragrafo inteiro, e tem de ser —
                 ela empurrava a lista de mensagens para cima.

                 Virou uma lupa na barra de titulo, ao lado do estado da
                 conexao. A declaracao do diario veio junto: o lugar de uma
                 ressalva e onde a coisa ressalvada acontece, e move-la para
                 uma tela de configuracoes seria a versao arrumadinha de
                 escondê-la. -->
            <Grid Grid.Row="1" Panel.ZIndex="11"
                  Visibility="{Binding BuscaAberta, Converter={StaticResource BoolToVis},
                                     FallbackValue=Collapsed}">

                <!-- Clicar fora fecha. Escurecer diz, sem texto, que o resto
                     nao responde enquanto isto esta aberto. -->
                <Rectangle Fill="#99000000">
                    <Rectangle.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding FecharBuscaCommand}" />
                    </Rectangle.InputBindings>
                </Rectangle>

                <Border Background="{DynamicResource Brush.Surface.1}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        MaxWidth="860" Margin="28"
                        VerticalAlignment="Top"
                        Padding="20,16,20,18">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="PROCURAR NO ACERVO"
                                       Style="{DynamicResource Text.Muted}"
                                       VerticalAlignment="Center" />
                            <Button Content="Fechar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding FecharBuscaCommand}"
                                    HorizontalAlignment="Right" Margin="16,0,0,0"
                                    AutomationProperties.Name="Fechar a busca" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0"
                                    Visibility="{Binding Busca, Converter={StaticResource NullToVis},
                                                         FallbackValue=Collapsed}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="PROCURAR NO ACERVO"
                                           Style="{DynamicResource Text.Muted}"
                                           VerticalAlignment="Center" />
                                <TextBox Text="{Binding Busca.Termo, UpdateSourceTrigger=PropertyChanged}"
                                         Width="240" Margin="12,0,0,0"
                                         VerticalAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="6,3"
                                         AutomationProperties.Name="Termo da busca no acervo">
                                    <TextBox.InputBindings>
                                        <!-- Enter procura. Sem isto o usuario digita
                                             e nao acontece nada, que e o formato de
                                             "parece quebrado" mais barato de evitar. -->
                                        <KeyBinding Key="Return" Command="{Binding Busca.ProcurarCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Content="Procurar"
                                        Style="{DynamicResource Toolbar.Button}"
                                        Command="{Binding Busca.ProcurarCommand}"
                                        Margin="8,0,0,0"
                                        ToolTip="Procura assunto e remetente no que ja foi varrido"
                                        AutomationProperties.Name="Procurar no acervo" />
                                <Button Content="Limpar"
                                        Style="{DynamicResource Toolbar.Button}"
                                        Command="{Binding Busca.LimparCommand}"
                                        Margin="6,0,0,0"
                                        AutomationProperties.Name="Limpar a busca" />
                                <TextBlock Text="{Binding Busca.Achados.Count, StringFormat={}{0} achado(s)}"
                                           Style="{DynamicResource Text.Muted}"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Visibility="{Binding Busca.Procurou,
                                                        Converter={StaticResource BoolToVis},
                                                        FallbackValue=Collapsed}" />
                            </StackPanel>

                            <!-- QUANTOS DESTES SAO PALPITE.
                                 A busca ganhou um segundo passe tolerante a erro
                                 de digitacao e a flexao. Medido em 29/08 sobre o
                                 acervo real: erro de digitacao subiu de 0,4% para
                                 93,8%, e flexao de 0% para 100%.
                                 O ganho tem preco, e o preco e ruido. Uma lista
                                 que misturasse os dois diria "a busca achou"
                                 quando o certo e "a busca achou algo parecido":
                                 a mesma familia de defeito que este projeto passou
                                 uma serie de revisoes corrigindo. -->
                            <!-- O DIARIO DE BUSCAS, DECLARADO NA TELA.
                                 O dono autorizou a coleta em 30/08. Autorizar nao
                                 e o mesmo que querer esquecer que ela existe: a
                                 faixa diz que esta anotando, quantas, e ONDE o
                                 arquivo esta. Arquivo que o usuario nao sabe
                                 localizar e arquivo que ele nao pode apagar, e
                                 poder apagar era metade do acordo.

                                 So o texto digitado entra ali. Nenhum assunto,
                                 nenhum remetente, nenhum EntryID. -->
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                        Visibility="{Binding Busca.RegistrandoBuscas,
                                                     Converter={StaticResource BoolToVis},
                                                     FallbackValue=Collapsed}">
                                <TextBlock Text="{Binding Busca.FraseDoDiario}"
                                           TextWrapping="Wrap"
                                           FontSize="11"
                                           MaxWidth="520"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           AutomationProperties.Name="O que o diario de buscas anota" />
                                <!-- DESLIGAR E APAGAR SAO DOIS BOTOES, e a
                                     primeira versao desta faixa so tinha o
                                     segundo. Apagar tira o que ja foi coletado, e
                                     a busca seguinte recria o arquivo: apagar
                                     nunca chega a ser "pare de coletar". Retirar
                                     consentimento precisa de botao proprio. -->
                                <Button Content="{Binding Busca.RotuloDoInterruptor}"
                                        Style="{DynamicResource Toolbar.Button}"
                                        Command="{Binding Busca.AlternarDiarioCommand}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Top"
                                        ToolTip="Liga ou desliga o registro das suas buscas. Fica valendo depois de fechar o Iris."
                                        AutomationProperties.Name="Ligar ou desligar o registro de buscas" />
                                <Button Content="Apagar registro"
                                        Style="{DynamicResource Toolbar.Button}"
                                        Command="{Binding Busca.ApagarDiarioCommand}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Top"
                                        ToolTip="Apaga o arquivo de buscas anotadas"
                                        AutomationProperties.Name="Apagar o diario de buscas" />
                            </StackPanel>

                            <TextBlock Text="{Binding Busca.FalhaDoDiario}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource Brush.Error}"
                                       Visibility="{Binding Busca.TemFalhaDoDiario,
                                                    Converter={StaticResource BoolToVis},
                                                    FallbackValue=Collapsed}"
                                       AutomationProperties.Name="Falha do diario de buscas" />

                            <TextBlock Text="{Binding Busca.FraseDosAproximados}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Visibility="{Binding Busca.TemAproximados,
                                                    Converter={StaticResource BoolToVis},
                                                    FallbackValue=Collapsed}"
                                       AutomationProperties.Name="Quantos achados sao aproximados" />

                            <!-- Altura limitada: o acervo tem mil linhas, e uma
                                 lista sem teto empurraria a lista de mensagens
                                 para fora da tela. -->
                            <ItemsControl ItemsSource="{Binding Busca.Achados}"
                                          MaxHeight="160" Margin="0,8,0,0">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Assunto}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Brush.Text.Primary}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Remetente}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                    <TextBlock Text="{Binding Pasta, StringFormat={} · {0}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                    <!-- "pode ja ter sido apagada": e o
                                                         que impede o resultado de parecer
                                                         o estado corrente da caixa. -->
                                                    <!-- A MARCA NA LINHA, e nao so no rodape:
                                                         quem le uma lista le linha a linha,
                                                         e um contador no rodape nao diz QUAL
                                                         das quinze e o palpite. -->
                                                    <TextBlock Text=" · aproximado"
                                                               FontSize="11"
                                                               FontStyle="Italic"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                                               Visibility="{Binding Aproximado,
                                                                            Converter={StaticResource BoolToVis},
                                                                            FallbackValue=Collapsed}"
                                                               AutomationProperties.Name="Este achado casou por aproximacao" />
                                                    <TextBlock Text="{Binding Aviso, StringFormat={} · {0}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource Brush.Error}"
                                                               Visibility="{Binding TemAviso,
                                                                            Converter={StaticResource BoolToVis},
                                                                            FallbackValue=Collapsed}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Quando}"
                                                       FontSize="11" Margin="12,0,0,0"
                                                       VerticalAlignment="Top"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding Busca.Ressalva}"
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                       Visibility="{Binding Busca.TemRessalva,
                                                    Converter={StaticResource BoolToVis},
                                                    FallbackValue=Collapsed}"
                                       AutomationProperties.Name="Ressalva da busca" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="1" Panel.ZIndex="10"
                  Visibility="{Binding Composer.IsOpen, Converter={StaticResource BoolToVis}}">

                <!-- Escurece o que esta atras para dizer, sem texto, que a
                     lista nao responde enquanto isto esta aberto. -->
                <Rectangle Fill="#99000000" />

                <Border Background="{DynamicResource Brush.Surface.1}"
                        BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius.Card}"
                        MaxWidth="980" Margin="28"
                        VerticalAlignment="Stretch">
                    <Grid Margin="24,20,24,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Cabecalho -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="{Binding Composer.Title}"
                                       Style="{StaticResource Text.Title}"
                                       VerticalAlignment="Center" />

                            <!-- Diz se o rascunho esta guardado. Sem isto o
                                 usuario nao tem como saber se pode fechar. -->
                            <TextBlock Grid.Column="1" Text="{Binding Composer.SaveHint}"
                                       Style="{StaticResource Text.Muted}"
                                       VerticalAlignment="Center" Margin="0,0,12,0" />

                            <Button Grid.Column="2" Style="{StaticResource CaptionButton}"
                                    Content="&#xE8BB;"
                                    Command="{Binding Composer.CloseCommand}"
                                    ToolTip="Fechar"
                                    AutomationProperties.Name="Fechar compositor" />
                        </Grid>

                        <!-- Destinatarios e assunto -->
                        <Grid Grid.Row="1" Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="PARA"
                                       Style="{StaticResource Input.Label}" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Style="{StaticResource Input.TextBox}"
                                     IsEnabled="{Binding Composer.PodeEditar}"
                                     AutomationProperties.Name="Destinatarios"
                                     Text="{Binding Composer.ToLine, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="CC"
                                       Style="{StaticResource Input.Label}" Margin="0,10,12,0" />
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,10,0,0"
                                     Style="{StaticResource Input.TextBox}"
                                     IsEnabled="{Binding Composer.PodeEditar}"
                                     AutomationProperties.Name="Com copia"
                                     Text="{Binding Composer.CcLine, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="ASSUNTO"
                                       Style="{StaticResource Input.Label}" Margin="0,10,12,0" />
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                                     Style="{StaticResource Input.TextBox}"
                                     IsEnabled="{Binding Composer.PodeEditar}"
                                     AutomationProperties.Name="Assunto"
                                     Text="{Binding Composer.Subject, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <!--
                            UpdateSourceTrigger=PropertyChanged nos quatro
                            campos, incluindo o corpo. O padrao do WPF e
                            LostFocus, e com ele o autosave so rodaria quando
                            o usuario trocasse de campo — ou seja, quase
                            nunca, que e exatamente o caso em que perder o
                            texto doi.
                        -->
                        <TextBox Grid.Row="2"
                                 Style="{StaticResource Input.Body}"
                                 IsEnabled="{Binding Composer.PodeEditar}"
                                 AutomationProperties.Name="Mensagem"
                                 Text="{Binding Composer.UserText, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Citacao e assinatura: exibicao, nunca edicao.
                             O Iris escreve ACIMA disto e nao reescreve. -->
                        <Expander Grid.Row="3" Margin="0,12,0,0"
                                  Foreground="{DynamicResource Brush.Text.Muted}"
                                  Header="Mensagem original e assinatura"
                                  Visibility="{Binding Composer.HasQuoted, Converter={StaticResource BoolToVis}}">
                            <Border Background="{DynamicResource Brush.Surface.2}"
                                    CornerRadius="{StaticResource Radius.Control}"
                                    Padding="12,10" Margin="0,8,0,0">
                                <TextBox Text="{Binding Composer.QuotedPreview, Mode=OneWay}"
                                         IsReadOnly="True" IsTabStop="False"
                                         BorderThickness="0" Background="Transparent"
                                         Foreground="{DynamicResource Brush.Text.Secondary}"
                                         FontFamily="{StaticResource Font.Ui}"
                                         FontSize="{StaticResource Font.Size.Small}"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MaxHeight="150"
                                         VerticalScrollBarVisibility="Auto"
                                         AutomationProperties.Name="Mensagem original" />
                            </Border>
                        </Expander>

                        <!-- Anexos -->
                        <ItemsControl Grid.Row="4" Margin="0,12,0,0"
                                      ItemsSource="{Binding Composer.Attachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Brush.Surface.3}"
                                            CornerRadius="{StaticResource Radius.Pill}"
                                            Padding="10,5" Margin="0,0,8,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE723;" FontSize="11" Margin="0,0,7,0"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                            <TextBlock Text="{Binding FileName}"
                                                       Style="{StaticResource Text.Body}"
                                                       FontSize="{StaticResource Font.Size.Small}"
                                                       VerticalAlignment="Center"
                                                       MaxWidth="220"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FileName}" />

                                            <Button Content="&#xE711;"
                                                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                    FontSize="10"
                                                    Margin="8,0,-2,0" Padding="4,1"
                                                    VerticalAlignment="Center"
                                                    Style="{StaticResource Toolbar.Button}"
                                                    ToolTip="Remover anexo"
                                                    AutomationProperties.Name="Remover anexo"
                                                    Command="{Binding DataContext.Composer.RemoveAttachmentCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Status. Vira aviso forte quando o envio ficou
                             sem resposta conhecida. -->
                        <Border Grid.Row="5" Margin="0,10,0,0"
                                CornerRadius="{StaticResource Radius.Control}"
                                Padding="12,9"
                                Visibility="{Binding Composer.HasStatus, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Surface.2}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Composer.IsSendUnknown}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource Brush.Accent.Surface}" />
                                        </DataTrigger>
                                        <!-- A sessao do Outlook trocou: o texto
                                             esta na tela mas a chave do rascunho
                                             e da sessao anterior. Nao pode
                                             parecer status comum. -->
                                        <DataTrigger Binding="{Binding Composer.SessaoSubstituida}" Value="True">
                                            <Setter Property="Background"
                                                    Value="{DynamicResource Brush.Accent.Surface}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Composer.Status}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Composer.IsSendUnknown}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Brush.Warning}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Composer.SessaoSubstituida}" Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Brush.Warning}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <!-- Rodape -->
                        <Grid Grid.Row="6" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource Composer.Action}"
                                    Command="{Binding Composer.AttachCommand}"
                                    Content="Anexar arquivo"
                                    AutomationProperties.Name="Anexar arquivo" />

                            <Button Grid.Column="2" Style="{StaticResource Button.Primary}"
                                    Command="{Binding Composer.RequestSendCommand}"
                                    Content="Revisar e enviar"
                                    AutomationProperties.Name="Revisar e enviar" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ Perguntas sobre o compositor ============ -->
                <Grid Visibility="{Binding Composer.ShowOverlay, Converter={StaticResource BoolToVis}}">
                    <Rectangle Fill="#B3000000" />

                    <!-- Confirmacao de envio. Mostra conta, destinatarios
                         RESOLVIDOS e assunto: e o ultimo ponto em que da
                         para descobrir que a mensagem ia para a pessoa
                         errada. -->
                    <Border Background="{DynamicResource Brush.Surface.1}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}"
                            Padding="24" MaxWidth="560"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Composer.IsConfirmingSend, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Enviar esta mensagem?"
                                       Style="{StaticResource Text.Title}" />

                            <TextBlock Style="{StaticResource Input.Label}" Text="ENVIANDO PELA CONTA"
                                       Margin="0,18,0,4" />
                            <TextBlock Text="{Binding Composer.PreviewAccount}"
                                       TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                        <Style.Triggers>
                                            <!-- Conta não determinada não pode
                                                 se parecer com conta
                                                 confirmada: esta tela existe
                                                 para confirmar POR QUAL CONTA,
                                                 e uma propriedade crítica que
                                                 ficou sem resposta tem de
                                                 aparecer como tal. -->
                                            <DataTrigger Binding="{Binding Composer.PreviewAccountUnknown}"
                                                         Value="True">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Brush.Warning}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Border Background="{DynamicResource Brush.Surface.2}"
                                    BorderBrush="{DynamicResource Brush.Warning}"
                                    BorderThickness="1,0,0,0"
                                    Padding="10,7" Margin="0,8,0,0"
                                    Visibility="{Binding Composer.PreviewAccountUnknown,
                                                 Converter={StaticResource BoolToVis}}">
                                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap"
                                           Text="O Outlook vai escolher a conta sozinho. Se você usa caixa compartilhada ou envio delegado, confira o remetente pelo Outlook antes de enviar por aqui." />
                            </Border>

                            <TextBlock Style="{StaticResource Input.Label}" Text="ASSUNTO"
                                       Margin="0,14,0,4" />
                            <TextBlock Text="{Binding Composer.Subject}"
                                       Style="{StaticResource Text.Body}" TextWrapping="Wrap" />

                            <TextBlock Style="{StaticResource Input.Label}" Text="DESTINATÁRIOS"
                                       Margin="0,14,0,4" />
                            <ItemsControl ItemsSource="{Binding Composer.PreviewRecipients}"
                                          MaxHeight="180">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="{Binding Kind}"
                                                       Style="{StaticResource Text.Muted}"
                                                       Width="42" VerticalAlignment="Center" />
                                            <!-- O endereco resolvido, nao o
                                                 nome de exibicao: e o
                                                 endereco que recebe. -->
                                            <TextBlock Text="{Binding Address}"
                                                       Style="{StaticResource Text.Body}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Anexos. Mandar o arquivo errado para fora é
                                 tão irreversível quanto mandar para a
                                 pessoa errada, e a lista vem do rascunho
                                 GRAVADO, não do editor. -->
                            <TextBlock Style="{StaticResource Input.Label}" Text="ANEXOS"
                                       Margin="0,14,0,4"
                                       Visibility="{Binding Composer.HasPreviewAttachments,
                                                    Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Composer.PreviewAttachments}"
                                          MaxHeight="110"
                                          Visibility="{Binding Composer.HasPreviewAttachments,
                                                       Converter={StaticResource BoolToVis}}">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="&#xE723;" FontSize="11" Margin="0,0,8,0"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Text.Muted}" />
                                            <TextBlock Text="{Binding FileName}"
                                                       Style="{StaticResource Text.Body}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        Margin="0,22,0,0">
                                <Button Style="{StaticResource Composer.Action}"
                                        Content="Voltar"
                                        Command="{Binding Composer.CancelSendCommand}"
                                        IsCancel="True"
                                        AutomationProperties.Name="Voltar à edição" />
                                <Button Style="{StaticResource Button.Primary}"
                                        Content="Enviar agora"
                                        Command="{Binding Composer.ConfirmSendCommand}"
                                        AutomationProperties.Name="Enviar agora" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Enviando. Sem botao: nao existe cancelar depois que
                         o Send comecou, e oferecer um seria mentir. -->
                    <Border Background="{DynamicResource Brush.Surface.1}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}"
                            Padding="28" MaxWidth="380"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Composer.IsSending, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Enviando…" Style="{StaticResource Text.Title}"
                                   TextAlignment="Center" />
                    </Border>

                    <!-- Fechar com alteracao pendente. Tres saidas, nenhuma
                         delas silenciosa. -->
                    <Border Background="{DynamicResource Brush.Surface.1}"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Card}"
                            Padding="24" MaxWidth="460"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Composer.IsConfirmingClose, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <!-- Sessão normal: salvar, descartar, continuar. -->
                            <StackPanel Visibility="{Binding Composer.SessaoSubstituida,
                                                     Converter={StaticResource NotBoolToVis}}">
                                <TextBlock Text="Há alterações não salvas"
                                           Style="{StaticResource Text.Title}" />
                                <TextBlock Style="{StaticResource Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="Salvar guarda o rascunho no Outlook. Descartar apaga a mensagem inteira, e não dá para desfazer." />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,22,0,0">
                                    <Button Style="{StaticResource Composer.Action}"
                                            Content="Continuar editando"
                                            Command="{Binding Composer.KeepEditingCommand}"
                                            IsCancel="True"
                                            AutomationProperties.Name="Continuar editando" />
                                    <Button Style="{StaticResource Composer.Action}"
                                            Content="Descartar"
                                            Command="{Binding Composer.DiscardCommand}"
                                            AutomationProperties.Name="Descartar rascunho" />
                                    <Button Style="{StaticResource Button.Primary}"
                                            Content="Salvar e fechar"
                                            Command="{Binding Composer.SaveAndCloseCommand}"
                                            AutomationProperties.Name="Salvar e fechar" />
                                </StackPanel>
                            </StackPanel>

                            <!--
                                Sessao substituida: nem salvar nem descartar
                                sao possiveis, porque a chave e da sessao
                                anterior. Oferecer "Descartar" aqui seria
                                prometer que apaga o rascunho, e ele nao
                                apaga nada.
                            -->
                            <StackPanel Visibility="{Binding Composer.SessaoSubstituida,
                                                     Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="A conexão com o Outlook mudou"
                                           Style="{StaticResource Text.Title}" />
                                <TextBlock Style="{StaticResource Text.Secondary}"
                                           TextWrapping="Wrap" Margin="0,10,0,0"
                                           Text="O que você escreveu até a última gravação já está salvo em Rascunhos, no Outlook. O que veio depois não foi salvo — copie antes de fechar." />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Margin="0,22,0,0">
                                    <Button Style="{StaticResource Composer.Action}"
                                            Content="Voltar e copiar"
                                            Command="{Binding Composer.KeepEditingCommand}"
                                            IsCancel="True"
                                            AutomationProperties.Name="Voltar e copiar" />
                                    <Button Style="{StaticResource Button.Primary}"
                                            Content="Fechar sem alterar o rascunho"
                                            Command="{Binding Composer.CloseLocallyCommand}"
                                            AutomationProperties.Name="Fechar sem alterar o rascunho" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ============ Agenda ============
                 Aparece so quando a pasta selecionada e de CALENDARIO, e por
                 isso divide a linha 2 com o acervo sem se sobrepor a ele: as
                 duas condicoes sao mutuamente exclusivas.

                 Foi exatamente uma sobreposicao nesta linha que escondeu a
                 faixa do acervo por dias: ela e a da IA moravam as duas em
                 Grid.Row=2, empilhadas. Aqui a exclusao e por CONTEUDO da
                 pasta, e nao por acaso de layout.

                 A agenda le AO VIVO do Outlook, como a lista, e ao contrario
                 do acervo. Nao ha retrato guardado, entao nao ha ressalva de
                 ACERVO, e isto NAO e o mesmo que cobertura completa.

                 Este comentario dizia "por isso ela nao tem ressalva de
                 cobertura", e a revisao externa pegou: o horizonte local so foi
                 medido no calendario PADRAO, e esta agenda abre qualquer pasta
                 classificada como calendario: caixa compartilhada, outro
                 store, ninguem mediu. Por isso o resumo diz sempre LIDO, com
                 zero itens ou com doze: "nenhum compromisso LIDO ate dd/MM" e
                 "12 compromisso(s) lido(s) ate dd/MM". Numero apresentado como
                 TOTAL e a mesma afirmacao que o zero era, so que mais dificil
                 de notar. -->
            <Border Grid.Row="2"
                    Visibility="{Binding Agenda.TemPasta, Converter={StaticResource BoolToVis},
                                         FallbackValue=Collapsed}"
                    Background="{DynamicResource Brush.Surface.1}"
                    BorderBrush="{DynamicResource Brush.Border.Subtle}"
                    BorderThickness="0,1,0,0"
                    Padding="16,8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="AGENDA"
                                   Style="{DynamicResource Text.Muted}"
                                   VerticalAlignment="Center" />
                        <Button Content="Atualizar"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding Agenda.AtualizarCommand}"
                                Margin="12,0,0,0"
                                ToolTip="Le de novo os proximos dias, ao vivo do Outlook"
                                AutomationProperties.Name="Atualizar a agenda" />
                        <TextBlock Text="{Binding Agenda.Resumo}"
                                   Style="{DynamicResource Text.Muted}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                        <ProgressBar IsIndeterminate="True"
                                     Width="90" Height="3" Margin="12,0,0,0"
                                     BorderThickness="0"
                                     Background="{DynamicResource Brush.Surface.3}"
                                     Foreground="{DynamicResource Brush.Accent}"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding Agenda.Carregando,
                                                  Converter={StaticResource BoolToVis},
                                                  FallbackValue=Collapsed}"
                                     AutomationProperties.Name="Lendo a agenda" />
                    </StackPanel>

                    <!-- CRIAR COMPROMISSO.
                         So aparece quando a agenda sabe escrever. Sem escritor
                         a faixa continua inteira, e nao mostra botao que nao
                         funciona.

                         Nao ha campo de participante, e a ausencia e a
                         funcionalidade: compromisso com participante e reuniao,
                         e salvar reuniao manda convite por e-mail. Ver o
                         comentario do CalendarWriting. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding Agenda.PodeEscrever,
                                             Converter={StaticResource BoolToVis},
                                             FallbackValue=Collapsed}">
                        <TextBox Text="{Binding Agenda.NovoAssunto, UpdateSourceTrigger=PropertyChanged}"
                                 Width="220"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Assunto do compromisso"
                                 AutomationProperties.Name="Assunto do novo compromisso" />
                        <TextBox Text="{Binding Agenda.NovaDuracaoMinutos, UpdateSourceTrigger=PropertyChanged}"
                                 Width="46" Margin="6,0,0,0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Duracao em minutos"
                                 AutomationProperties.Name="Duracao em minutos" />
                        <TextBlock Text="min" VerticalAlignment="Center" Margin="4,0,0,0"
                                   Style="{DynamicResource Text.Muted}" />
                        <Button Content="Criar"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding Agenda.CriarCommand}"
                                Margin="10,0,0,0"
                                ToolTip="Cria um compromisso neste calendario. Sem participantes: o Iris nao manda convite."
                                AutomationProperties.Name="Criar compromisso" />
                        <Button Content="Apagar"
                                Style="{DynamicResource Toolbar.Button}"
                                Command="{Binding Agenda.PedirExclusaoCommand}"
                                Margin="6,0,0,0"
                                ToolTip="Pergunta antes de apagar o compromisso selecionado"
                                AutomationProperties.Name="Apagar o compromisso selecionado" />
                    </StackPanel>

                    <!-- A PERGUNTA. Apagar nao tem desfazer visivel: o item vai
                         para os Itens Excluidos e ninguem olha la. Um clique
                         nao basta, e a pergunta cita o assunto para nao haver
                         duvida sobre QUAL compromisso. -->
                    <Border Margin="0,0,0,8" Padding="10,8"
                            Background="{DynamicResource Brush.Surface.2}"
                            BorderBrush="{DynamicResource Brush.Border.Subtle}"
                            BorderThickness="1" CornerRadius="3"
                            Visibility="{Binding Agenda.EstaConfirmando,
                                         Converter={StaticResource BoolToVis},
                                         FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Agenda.PerguntaDaExclusao}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Content="Apagar mesmo assim"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Agenda.ApagarCommand}"
                                    Margin="12,0,0,0"
                                    AutomationProperties.Name="Confirmar a exclusao do compromisso" />
                            <Button Content="Cancelar"
                                    Style="{DynamicResource Toolbar.Button}"
                                    Command="{Binding Agenda.CancelarExclusaoCommand}"
                                    Margin="6,0,0,0"
                                    AutomationProperties.Name="Cancelar a exclusao" />
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Agenda.Compromissos}"
                                  MaxHeight="180">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Quando}"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"
                                               VerticalAlignment="Top" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Assunto}"
                                                       FontSize="12"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Brush.Text.Primary}" />
                                            <!-- Ocorrencia de serie nao e compromisso
                                                 avulso: mexer nela mexe na serie, e
                                                 quem clica precisa saber antes. -->
                                            <TextBlock Text=" · série"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.Text.Secondary}"
                                                       Visibility="{Binding EhSerie,
                                                                    Converter={StaticResource BoolToVis},
                                                                    FallbackValue=Collapsed}" />
                                            <!-- A unica informacao da agenda que
                                                 PEDE acao, entao e a destacada. -->
                                            <TextBlock Text=" · não respondido"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource Brush.Error}"
                                                       Visibility="{Binding Pendente,
                                                                    Converter={StaticResource BoolToVis},
                                                                    FallbackValue=Collapsed}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Local}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource Brush.Text.Secondary}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Agenda.Erro}"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.Error}"
                               Visibility="{Binding Agenda.TemErro,
                                            Converter={StaticResource BoolToVis},
                                            FallbackValue=Collapsed}"
                               AutomationProperties.Name="Falha ao ler a agenda" />
                </StackPanel>
            </Border>

            <!-- ============ Acervo ============
                 O que a varredura ja guardou no cache, e a RESSALVA que ele
                 obriga a mostrar junto.

                 Nao e a lista: ela continua lendo ao vivo do Outlook. Este e o
                 acervo, e a §23 explica por que sao coisas diferentes - em modo
                 cached ele e um arquivo historico conservador, nao o estado
                 corrente da caixa. Uma UI que exibisse um como o outro
                 enganaria, e enganaria em silencio.

                 A faixa some quando nao ha ressalva nem falha - o que hoje
                 nunca acontece em modo cached, e e proposital que nao
                 aconteca. -->
            <!-- VISIVEL SEMPRE QUE HA ACERVO, e nao so quando ha ressalva.

                 A visibilidade era TemAlgoADizer, e com ela o BOTAO de varrer
                 sumiria justamente quando nao ha nada a ressalvar - que e
                 quando alguem quer varrer. E o mesmo defeito que a faixa da IA
                 teve: botao que some esconde a funcionalidade E o motivo dela
                 estar indisponivel.

                 Acervo nulo (cache que nao abriu) colapsa pelo conversor, e a
                 outra borda desta mesma linha assume. -->
            <!-- E O ACERVO SOME QUANDO A AGENDA APARECE.

                 As duas dividem a linha 2. Sem esta condicao elas se
                 empilhariam, e a de cima cobriria a de baixo, que foi
                 literalmente o defeito que escondeu a faixa do acervo por
                 dias, quando ela e a da IA moravam as duas em Grid.Row=2. -->


            <!-- A FAIXA DA IA.

                 Extraida para um UserControl porque o teste de renderizacao
                 precisa instanciar a FAIXA DE VERDADE. Enquanto ele
                 reconstruia uma imitacao, ele nao pegou o defeito obvio: os
                 botoes estavam DENTRO da borda de aviso, e com a IA
                 funcionando - sem aviso e sem ambiguidades - a borda colapsa e
                 leva os botoes junto.

                 O UserControl nao precisa de broker nem de Outlook: ele so
                 tem bindings. -->
            <local:FaixaDaIa Grid.Row="3" DataContext="{Binding Assistente}" />



        </Grid>
    </Border>
</Window>
