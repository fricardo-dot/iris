<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Sem -windows: persistencia nao ve COM. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iris.Cache</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Iris.Model\Iris.Model.vbproj" />
    <ProjectReference Include="..\Iris.Core\Iris.Core.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Iris.Tests" />
  </ItemGroup>

</Project>
