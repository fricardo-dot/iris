<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Iris.CrashHarness</RootNamespace>
    <StartupObject>Iris.CrashHarness.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Iris.Core\Iris.Core.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Cache\Iris.Cache.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Sync\Iris.Sync.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Integration\Iris.Integration.vbproj" />
  </ItemGroup>

</Project>
