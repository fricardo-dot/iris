<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Iris.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- WPF nos testes: a prova de virtualizacao precisa de janela real. -->
    <UseWPF>true</UseWPF>

    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.7.3" />
    <PackageReference Include="MSTest.TestFramework" Version="3.7.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Todos os projetos, porque os testes arquiteturais precisam
         INSPECIONAR os assemblies para provar que a fronteira existe. -->
    <ProjectReference Include="..\..\src\Iris.Model\Iris.Model.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Core\Iris.Core.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Outlook\Iris.Outlook.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Cache\Iris.Cache.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Sync\Iris.Sync.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Assist\Iris.Assist.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Integration.Assist.Http\Iris.Integration.Assist.Http.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Integration\Iris.Integration.vbproj" />
    <ProjectReference Include="..\..\src\Iris.Integration.Outlook\Iris.Integration.Outlook.vbproj" />

    <!--
      O harness de crash NAO e referencia de codigo - o teste o executa como
      PROCESSO. Mas precisa ser CONSTRUIDO junto, e ReferenceOutputAssembly
      false diz exatamente isso.

      Sem esta linha o exe fica obsoleto em silencio: quando o CacheSchema
      mudou, o harness continuou compilado contra o schema velho e passou a
      ver as colunas novas como "EXTRA no banco". Quem acusou foi a
      introspeccao, fazendo o trabalho dela.

      E o tools/conferir-crash.py NAO pegaria isso: ele cria o banco com o
      PROPRIO harness, entao fica auto-consistente com qualquer versao,
      inclusive velha.
    -->
    <ProjectReference Include="..\..\tools\Iris.CrashHarness\Iris.CrashHarness.vbproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Iris.App\Iris.App.vbproj" />
  </ItemGroup>

</Project>
